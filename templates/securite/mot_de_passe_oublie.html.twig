{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié - GlitchWorlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body %}
<section class="gw-panel p-4 p-md-5 mx-auto" style="max-width: 620px">
    <h1 class="h2">Mot de passe oublié</h1>
    <p class="text-secondary">Indique ton adresse e-mail pour recevoir un lien valable une heure.</p>
    {{ form_start(formulaire) }}
        {{ form_row(formulaire.email) }}
        {{ form_widget(formulaire.envoyer) }}
    {{ form_end(formulaire) }}
    <a class="d-inline-block mt-3" href="{{ path('app_connexion') }}">Retour à la connexion</a>
</section>
{% endblock %}
