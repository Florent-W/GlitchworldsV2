{% extends 'base.html.twig' %}

{% block title %}Mon compte - GlitchWorlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}

{% block body %}
<section class="gw-panel p-4 p-md-5 mx-auto" style="max-width: 760px">
    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="gw-comment__avatar fs-4" aria-hidden="true">{{ app.user.pseudo|first|upper }}</div>
            <div>
                <h1 class="h2 mb-1">{{ app.user.pseudo }}</h1>
                <p class="text-secondary mb-0">{{ app.user.email ?? 'Aucune adresse e-mail' }}</p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="{{ path('app_profil', {id: app.user.id}) }}"><i class="bi bi-person-fill me-2"></i>Voir mon profil</a>
            <a class="btn btn-primary" href="{{ path('app_compte_modifier') }}">
                <i class="bi bi-pencil-fill me-2" aria-hidden="true"></i>Modifier
            </a>
            <a class="btn btn-outline-primary" href="{{ path('app_compte_mot_de_passe') }}">
                <i class="bi bi-key-fill me-2" aria-hidden="true"></i>Mot de passe
            </a>
            <a class="btn btn-outline-danger" href="{{ path('app_deconnexion') }}">
                <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Se déconnecter
            </a>
        </div>
    </div>

    {% if app.user.email is null %}
        <div class="alert alert-warning d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mt-4 mb-0" role="alert">
            <div>
                <strong>Compte legacy récupéré.</strong>
                Ajoute une adresse e-mail unique pour sécuriser ton accès.
            </div>
            <a class="btn btn-warning text-nowrap" href="{{ path('app_compte_modifier') }}">Ajouter mon e-mail</a>
        </div>
    {% endif %}

    <hr class="my-4">

    <h2 class="h5">Compte GlitchWorlds</h2>
    <dl class="row mb-0">
        <dt class="col-sm-4">Identifiant</dt>
        <dd class="col-sm-8">#{{ app.user.id }}</dd>
        <dt class="col-sm-4">Rôle</dt>
        <dd class="col-sm-8">Membre</dd>
        <dt class="col-sm-4">Jeux favoris</dt>
        <dd class="col-sm-8">{{ app.user.jeuxFavoris|length }}</dd>
    </dl>

    {% if app.user.jeuxFavoris is not empty %}
        <h2 class="h5 mt-4">Mes favoris</h2>
        <div class="d-flex flex-wrap gap-2">
            {% for jeu in app.user.jeuxFavoris %}
                <a class="gw-tag" href="{{ path('app_jeu_show', { slug: jeu.slug, id: jeu.id }) }}">{{ jeu.nom }}</a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="d-flex justify-content-between align-items-center gap-3 mt-4 mb-3">
        <h2 class="h5 mb-0">Mes propositions de jeux</h2>
        <a class="btn btn-sm btn-primary" href="{{ path('app_jeu_proposer') }}">Proposer un jeu</a>
    </div>
    {% if propositions is empty %}
        <p class="text-secondary mb-0">Tu n’as envoyé aucune proposition de jeu.</p>
    {% else %}
        <div class="list-group mb-4">
            {% for jeu in propositions %}
                <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div><strong>{{ jeu.nom }}</strong><span class="badge text-bg-secondary ms-2">{{ jeu.statut.label }}</span></div>
                    {% if is_granted('PROPOSITION_JEU_MODIFIER', jeu) %}
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_jeu_proposition_modifier', { id: jeu.id }) }}">Modifier la proposition</a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <h2 class="h5 mb-0">Mes propositions d’actualités</h2>
        <a class="btn btn-sm btn-primary" href="{{ path('app_actualite_proposer') }}">Proposer une actualité</a>
    </div>
    {% if propositionsActualites is empty %}
        <p class="text-secondary mb-0">Tu n’as envoyé aucune actualité.</p>
    {% else %}
        <div class="list-group">
            {% for actualite in propositionsActualites %}
                <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div><strong>{{ actualite.titre }}</strong><span class="badge text-bg-secondary ms-2">{{ actualite.statut.label }}</span></div>
                    {% if is_granted('PROPOSITION_ACTUALITE_MODIFIER', actualite) %}
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_actualite_proposition_modifier', { id: actualite.id }) }}">Modifier la proposition</a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
