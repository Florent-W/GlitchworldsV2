<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Glitchworlds{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f6f8;padding:24px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border:1px solid #dbe1e8;border-radius:12px;overflow:hidden;">
                <tr>
                    <td style="padding:24px 28px 12px;border-bottom:1px solid #e8edf2;">
                        <p style="margin:0;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;">Glitchworlds</p>
                        <h1 style="margin:8px 0 0;font-size:22px;line-height:1.35;color:#111827;">{% block heading %}{% endblock %}</h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 28px 28px;font-size:15px;line-height:1.65;color:#334155;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 28px 24px;border-top:1px solid #e8edf2;font-size:12px;line-height:1.6;color:#64748b;">
                        {% block footer %}
                            <p style="margin:0 0 8px;">Cet e-mail a été envoyé par <strong>Glitchworlds</strong>.</p>
                            <p style="margin:0;">Site : <a href="{{ site_url|default('#') }}" style="color:#2563eb;text-decoration:none;">{{ site_url|default('Glitchworlds.com') }}</a></p>
                        {% endblock %}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
