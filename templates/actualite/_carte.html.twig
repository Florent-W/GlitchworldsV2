<article class="card border-0 shadow-sm h-100 overflow-hidden gw-article-card">
    {% include 'actualite/_vignette_liste.html.twig' with { actualite: actualite, hauteur: hauteurImage|default(180) } only %}
    <div class="card-body d-flex flex-column">
        <span class="badge text-bg-primary align-self-start mb-2">{{ actualite.categorie.label }}</span>
        <h3 class="h5 card-title mb-2"><a class="stretched-link text-decoration-none" href="{{ path('app_actualite_voir', { slug: actualite.slug, id: actualite.id }) }}">{{ actualite.titre }}</a></h3>
        <p class="card-text text-secondary small mb-2">{{ actualite.description }}</p>
        <p class="small text-secondary mt-auto mb-0">{{ actualite.publieeLe|date('d/m/Y') }}{% if actualite.auteur %} · {{ actualite.auteur.pseudo }}{% endif %}</p>
    </div>
</article>
