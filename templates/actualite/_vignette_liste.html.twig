{% set fichier = actualite.fichierVignetteListe %}
{% if fichier %}
    <img
        class="{{ classes|default('card-img-top object-fit-cover') }}"
        {% if hauteur is defined %}style="height: {{ hauteur }}px"{% endif %}
        src="{{ asset('uploads/actualites/' ~ actualite.id ~ '/' ~ fichier) }}"
        alt="{{ alt|default('Illustration de ' ~ actualite.titre) }}"
        loading="{{ loading|default('lazy') }}"
        {% if decoding is defined %}decoding="{{ decoding }}"{% endif %}
    >
{% endif %}
