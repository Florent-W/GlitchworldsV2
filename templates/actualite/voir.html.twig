{% extends 'base.html.twig' %}

{% block title %}{{ actualite.titre }} - GlitchWorlds{% endblock %}
{% block meta_description %}{{ actualite.description }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block canonical %}{{ url('app_actualite_voir', { slug: actualite.slug, id: actualite.id }) }}{% endblock %}
{% block structured_data %}<script type="application/ld+json">{{ { '@context': 'https://schema.org', '@type': 'Article', headline: actualite.titre, description: actualite.description, datePublished: actualite.publieeLe|date('c'), author: { '@type': 'Person', name: actualite.auteur ? actualite.auteur.pseudo : 'GlitchWorlds' } }|json_encode|raw }}</script>{% endblock %}

{% block body %}
<article class="gw-panel p-4 p-lg-5 mx-auto" style="max-width: 980px">
    <nav aria-label="Fil d’Ariane"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_actualites') }}">Actualités</a></li><li class="breadcrumb-item active" aria-current="page">{{ actualite.categorie.label }}</li></ol></nav>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <span class="badge text-bg-primary">{{ actualite.categorie.label }}</span>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-warning" href="{{ path('app_administration_actualites_modifier', { id: actualite.id }) }}"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Modifier l’actualité</a>
        {% endif %}
    </div>
    <h1 class="display-6">{{ actualite.titre }}</h1>
    <p class="lead text-secondary">{{ actualite.description }}</p>
    <p class="small text-secondary">Publié le {{ actualite.publieeLe|format_datetime('long', 'none', locale='fr') }}{% if actualite.auteur %} par {{ actualite.auteur.pseudo }}{% endif %}</p>
    {% if actualite.miniature and not (actualite.miniature starts with 'legacy:') %}<img class="img-fluid rounded-4 w-100 mb-4" src="{{ asset('uploads/actualites/' ~ actualite.id ~ '/' ~ actualite.miniature) }}" alt="Miniature de {{ actualite.titre }}" style="max-height: 520px; object-fit: cover" loading="eager" fetchpriority="high" decoding="async">{% endif %}
    <hr>
    <div class="gw-article-content">{{ actualite.contenu|bbcode }}</div>
    {% if actualite.jeux is not empty %}
        <hr>
        <h2 class="h5">Jeux concernés</h2>
        <div class="d-flex flex-wrap gap-2">{% for jeu in actualite.jeux %}<a class="gw-tag" href="{{ path('app_jeu_show', { slug: jeu.slug, id: jeu.id }) }}"><i class="bi bi-controller me-1" aria-hidden="true"></i>{{ jeu.nom }}</a>{% endfor %}</div>
    {% endif %}
</article>

<section id="commentaires" class="gw-panel p-4 mt-4 mx-auto" style="max-width: 980px">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h4 mb-0"><i class="bi bi-chat-dots-fill text-primary me-2" aria-hidden="true"></i>Commentaires</h2>
        <span class="gw-result-count">{{ totalCommentaires }}</span>
    </div>
    <div class="vstack gap-3 mb-4">
        {% for commentaire in commentaires %}
            <article id="commentaire-{{ commentaire.id }}" class="gw-comment">
                <div class="gw-comment__avatar" aria-hidden="true">{{ commentaire.auteur ? commentaire.auteur.pseudo|first|upper : '?' }}</div>
                <div class="flex-grow-1">
                    <header class="d-flex flex-wrap align-items-center gap-2">
                        <strong>{{ commentaire.auteur ? commentaire.auteur.pseudo : 'Membre supprimé' }}</strong>
                        <time class="small text-secondary" datetime="{{ commentaire.dateCommentaire|date('c') }}">{{ commentaire.dateCommentaire|format_datetime('medium', 'short', locale='fr') }}</time>
                        {% if app.user %}<form class="ms-auto" method="post" action="{{ path('app_actualite_commentaire_aimer', { id: commentaire.id }) }}"><input type="hidden" name="_token" value="{{ csrf_token('aimer-commentaire-actualite-' ~ commentaire.id) }}"><button class="btn btn-sm {{ commentaire.aimePar.contains(app.user) ? 'btn-primary' : 'btn-outline-primary' }}" type="submit" aria-label="Aimer"><i class="bi bi-hand-thumbs-up-fill" aria-hidden="true"></i> {{ commentaire.aimePar|length }}</button></form>{% else %}<span class="ms-auto small text-secondary"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i> {{ commentaire.aimePar|length }}</span>{% endif %}
                        {% if is_granted('COMMENTAIRE_ACTUALITE_MODIFIER', commentaire) %}<a class="btn btn-sm btn-outline-primary" href="{{ path('app_actualite_commentaire_modifier', { id: commentaire.id }) }}" aria-label="Modifier"><i class="bi bi-pencil-fill" aria-hidden="true"></i></a>{% endif %}
                        {% if is_granted('COMMENTAIRE_ACTUALITE_SUPPRIMER', commentaire) %}<form method="post" action="{{ path('app_actualite_commentaire_supprimer', { id: commentaire.id }) }}"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-commentaire-actualite-' ~ commentaire.id) }}"><button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Supprimer"><i class="bi bi-trash-fill" aria-hidden="true"></i></button></form>{% endif %}
                    </header>
                    <div>{{ commentaire.contenu|nl2br }}</div>

                    {% if commentaire.reponses is not empty %}
                        <div class="gw-comment-replies vstack gap-2">
                            {% for reponse in commentaire.reponses %}
                                <article class="gw-comment gw-comment--reply">
                                    <div class="gw-comment__avatar" aria-hidden="true">{{ reponse.auteur ? reponse.auteur.pseudo|first|upper : '?' }}</div>
                                    <div class="flex-grow-1">
                                        <header class="d-flex flex-wrap align-items-center gap-2"><strong>{{ reponse.auteur ? reponse.auteur.pseudo : 'Membre supprimé' }}</strong><span class="badge rounded-pill text-bg-light">Réponse</span><time class="small text-secondary" datetime="{{ reponse.dateCommentaire|date('c') }}">{{ reponse.dateCommentaire|format_datetime('medium', 'short', locale='fr') }}</time>{% if app.user %}<form class="ms-auto" method="post" action="{{ path('app_actualite_commentaire_aimer', { id: reponse.id }) }}"><input type="hidden" name="_token" value="{{ csrf_token('aimer-commentaire-actualite-' ~ reponse.id) }}"><button class="btn btn-sm {{ reponse.aimePar.contains(app.user) ? 'btn-primary' : 'btn-outline-primary' }}" type="submit" aria-label="Aimer la réponse"><i class="bi bi-hand-thumbs-up-fill" aria-hidden="true"></i> {{ reponse.aimePar|length }}</button></form>{% else %}<span class="ms-auto small text-secondary"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i> {{ reponse.aimePar|length }}</span>{% endif %}{% if is_granted('COMMENTAIRE_ACTUALITE_MODIFIER', reponse) %}<a class="btn btn-sm btn-outline-primary" href="{{ path('app_actualite_commentaire_modifier', { id: reponse.id }) }}" aria-label="Modifier la réponse"><i class="bi bi-pencil-fill" aria-hidden="true"></i></a>{% endif %}{% if is_granted('COMMENTAIRE_ACTUALITE_SUPPRIMER', reponse) %}<form method="post" action="{{ path('app_actualite_commentaire_supprimer', { id: reponse.id }) }}"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-commentaire-actualite-' ~ reponse.id) }}"><button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Supprimer la réponse"><i class="bi bi-trash-fill" aria-hidden="true"></i></button></form>{% endif %}</header>
                                        <div>{{ reponse.contenu|nl2br }}</div>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <details class="gw-reply-form mt-2"><summary class="btn btn-sm btn-link px-0"><i class="bi bi-reply-fill me-1" aria-hidden="true"></i>Répondre</summary><form class="mt-2" method="post" action="{{ path('app_actualite_commentaire_repondre', { id: commentaire.id }) }}"><input type="hidden" name="_token" value="{{ csrf_token('repondre-commentaire-actualite-' ~ commentaire.id) }}"><label class="visually-hidden" for="reponse-actualite-{{ commentaire.id }}">Ta réponse</label><textarea id="reponse-actualite-{{ commentaire.id }}" class="form-control" name="contenu" rows="3" minlength="3" maxlength="1000" required placeholder="Écris ta réponse..."></textarea><div class="d-flex justify-content-end mt-2"><button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-send-fill me-1" aria-hidden="true"></i>Publier la réponse</button></div></form></details>
                    {% else %}
                        <a class="btn btn-sm btn-link px-0 mt-1" href="{{ path('app_connexion') }}"><i class="bi bi-reply-fill me-1" aria-hidden="true"></i>Se connecter pour répondre</a>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <p class="text-secondary">Aucun commentaire pour le moment.</p>
        {% endfor %}
    </div>
    <div class="border-top pt-4">
        {{ form_start(formulaireCommentaire) }}
            {{ form_row(formulaireCommentaire.contenu) }}
            <div class="d-flex justify-content-between align-items-center gap-2">
                <small class="{{ app.user ? 'gw-text-violet' : 'text-secondary' }}">{% if app.user %}Entre 3 et 1 000 caractères.{% else %}<a href="{{ path('app_connexion') }}">Connecte-toi</a> pour commenter.{% endif %}</small>
                {{ form_widget(formulaireCommentaire.publier) }}
            </div>
        {{ form_end(formulaireCommentaire) }}
    </div>
</section>
{% endblock %}
