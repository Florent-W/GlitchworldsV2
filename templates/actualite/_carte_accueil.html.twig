{# Tuile compacte pour l'accueil (menu HOME 3DS et grilles jeux). #}
{% set cat = actualite.categorie.value %}
<article class="gw-similar-card h-100" data-carte-type="actualite" data-son-survol="survol-article">
    <a class="gw-similar-card__visual gw-similar-card__visual--{{ cat }}" href="{{ path('app_actualite_voir', { slug: actualite.slug, id: actualite.id }) }}" aria-label="Lire {{ actualite.titre }}">
        {% if actualite.fichierVignetteListe %}
            <img class="w-100 h-100 object-fit-cover" src="{{ asset('uploads/actualites/' ~ actualite.id ~ '/' ~ actualite.fichierVignetteListe) }}" alt="" loading="lazy" decoding="async">
        {% else %}
            {% if cat == 'glitchs' %}
                <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
            {% elseif cat == 'mods' %}
                <i class="bi bi-puzzle-fill" aria-hidden="true"></i>
            {% elseif cat == 'tutoriels' %}
                <i class="bi bi-book-fill" aria-hidden="true"></i>
            {% else %}
                <i class="bi bi-newspaper" aria-hidden="true"></i>
            {% endif %}
        {% endif %}
        {% include 'actualite/_categorie_badge.html.twig' with { actualite: actualite } only %}
    </a>
    <div class="p-3">
        <h3 class="h6 mb-0"><a class="stretched-link text-decoration-none text-body" href="{{ path('app_actualite_voir', { slug: actualite.slug, id: actualite.id }) }}">{{ actualite.titre }}</a></h3>
    </div>
</article>
