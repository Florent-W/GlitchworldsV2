<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}GlitchWorlds{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Bienvenue sur GlitchWorlds - fangames, hacks, mods et communauté.{% endblock %}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌐</text></svg>">
        <link rel="canonical" href="{% block canonical %}{{ app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo }}{% endblock %}">
        <meta name="robots" content="{% block robots_meta %}index,follow{% endblock %}">
        <meta property="og:site_name" content="GlitchWorlds">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:title" content="{{ block('title')|striptags|trim }}">
        <meta property="og:description" content="{{ block('meta_description')|striptags|trim }}">
        <meta property="og:url" content="{{ block('canonical')|trim }}">
        {% block structured_data %}{% endblock %}
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% set current_route = app.request.attributes.get('_route') %}
        {% set nav_items = [
            { label: 'Accueil',    icon: 'house-door-fill', route: 'app_home' },
            { label: 'Jeux',       icon: 'controller',      route: 'app_jeux' },
            { label: 'Favoris',    icon: 'heart-fill',      route: 'app_favoris' },
            { label: 'Communauté', icon: 'people-fill',     route: null },
            { label: 'Actualités', icon: 'newspaper',     route: null },
            { label: 'Paramètres', icon: 'gear-fill',       route: null },
            { label: 'Boutique',   icon: 'bag-fill',        route: null, badge: 'New' }
        ] %}

        <div class="gw-app">
            <header class="gw-topbar">
                <a class="gw-logo" href="{{ path('app_home') }}">
                    <span class="gw-logo__name">Glitch<span class="gw-logo__accent">Worlds</span></span>
                    <span class="gw-logo__tagline">Play. Hack. Rewrite Reality.</span>
                </a>

                <search class="gw-search">
                    <form role="search" action="{{ path('app_jeux') }}" method="get">
                        <label class="visually-hidden" for="gw-search-input">Rechercher</label>
                        <i class="bi bi-search gw-search__icon" aria-hidden="true"></i>
                        <input id="gw-search-input" class="gw-search__input" type="search" name="recherche"
                               placeholder="Rechercher un fangame, un univers..." autocomplete="off">
                    </form>
                </search>

                <div class="gw-actions">
                    <button type="button" class="gw-icon-btn" aria-label="Activer ou couper les sons d'interface">
                        <i class="bi bi-volume-up-fill" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="gw-icon-btn" aria-label="Changer de thème">
                        <i class="bi bi-brightness-high-fill" aria-hidden="true"></i>
                    </button>
                    <a class="gw-icon-btn gw-icon-btn--avatar" href="{{ path(app.user ? 'app_compte' : 'app_connexion') }}" aria-label="{{ app.user ? 'Mon compte' : 'Se connecter' }}" title="{{ app.user ? app.user.userIdentifier : 'Se connecter' }}">
                        <i class="bi bi-person-fill" aria-hidden="true"></i>
                        <span class="gw-status-dot" aria-hidden="true"></span>
                    </a>
                </div>
            </header>

            <div class="gw-layout">
                <nav class="gw-rail" aria-label="Navigation principale">
                    <ul class="gw-rail__list">
                        {% for item in nav_items %}
                            {% set is_active = item.route is not null and item.route == current_route %}
                            <li>
                                <a class="gw-rail__item{{ is_active ? ' is-active' : '' }}"
                                   href="{{ item.route ? path(item.route) : '#' }}"
                                   {{ is_active ? 'aria-current="page"' : '' }}>
                                    <i class="bi bi-{{ item.icon }}" aria-hidden="true"></i>
                                    <span class="gw-rail__label">{{ item.label }}</span>
                                    {% if item.badge is defined %}
                                        <span class="gw-rail__badge">{{ item.badge }}</span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>

                <main class="gw-main">
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}
                    {% block body %}{% endblock %}
                </main>
            </div>

            <footer class="gw-bottombar">
                <div class="gw-bottombar__side">
                    <a class="gw-console-btn" href="#" aria-label="Passer en mode console">
                        <i class="bi bi-controller" aria-hidden="true"></i>
                        <span>Mode</span>
                    </a>
                    <div class="gw-storage">
                        <i class="bi bi-sd-card" aria-hidden="true"></i>
                        <span>
                            <strong>Stockage libre</strong>
                            12,4 Go
                        </span>
                    </div>
                </div>

                <div class="gw-clock" data-controller="horloge">
                    <time data-horloge-target="time" datetime="{{ 'now'|date('c') }}">
                        {# Fallback serveur si JS désactivé #}
                        <strong data-horloge-target="heure">{{ 'now'|date('H:i') }}</strong>
                        <span data-horloge-target="date">{{ 'now'|format_datetime('none', 'none', 'EEEE d MMMM y', locale='fr')|capitalize }}</span>
                    </time>
                    <i class="bi bi-wifi" aria-hidden="true"></i>
                </div>

                <div class="gw-bottombar__side gw-bottombar__side--end">
                    <a class="gw-messages" href="#">
                        <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                        <span>Messages</span>
                        <span class="gw-messages__count">3</span>
                    </a>
                </div>
            </footer>
        </div>
    </body>
</html>
