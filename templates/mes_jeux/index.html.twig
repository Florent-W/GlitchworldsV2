{% extends 'base.html.twig' %}
{% block title %}Mes jeux et succès - GlitchWorlds{% endblock %}
{% block body %}
<main class="container-fluid py-4">
    <header class="gw-page-heading mb-4"><div><span class="gw-eyebrow"><i class="bi bi-collection-play-fill"></i> Bibliothèque</span><h1 class="display-5 fw-bold mb-1">Mes jeux</h1><p class="text-secondary mb-0">Suis ta progression, organise tes listes et débloque des succès.</p></div><div class="gw-shop__balance"><i class="bi bi-star-fill"></i><span><strong>{{ app.user.points }}</strong> points</span></div></header>
    <ul class="nav nav-pills gap-2 mb-4" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#bibliotheque" type="button">Bibliothèque <span class="badge text-bg-light ms-1">{{ bibliotheque|length }}</span></button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#listes" type="button">Mes listes</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#succes" type="button">Succès <span class="badge text-bg-warning ms-1">{{ succesAcquis|length }}/{{ succes|length }}</span></button></li></ul>
    <div class="tab-content">
        <section class="tab-pane fade show active" id="bibliotheque"><div class="row g-3">{% for entree in bibliotheque %}<div class="col-md-6 col-xl-4"><article class="gw-panel p-3 h-100"><div class="d-flex gap-3"><span class="gw-bibliotheque-thumb">{% if entree.jeu.miniature starts with 'miniature.' %}<img src="{{ asset('uploads/jeux/' ~ entree.jeu.id ~ '/' ~ entree.jeu.miniature) }}" alt="" width="96" height="96" class="rounded-3 object-fit-cover" loading="lazy">{% else %}<span class="gw-bibliotheque-thumb__fallback"><i class="bi bi-controller"></i></span>{% endif %}{% include 'jeu/_note_badge.html.twig' with { note: notesJeux[entree.jeu.id]|default(null) } only %}</span><div class="flex-grow-1"><h2 class="h5"><a class="text-decoration-none" href="{{ path('app_jeu_show', {id: entree.jeu.id, slug: entree.jeu.slug}) }}">{{ entree.jeu.nom }}</a></h2><form method="post" action="{{ path('app_mes_jeux_ajouter', {id: entree.jeu.id}) }}" class="mb-2"><input type="hidden" name="_token" value="{{ csrf_token('bibliotheque-' ~ entree.jeu.id) }}"><select name="statut" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Progression pour {{ entree.jeu.nom }}">{% for statut in statuts %}<option value="{{ statut.value }}" {{ entree.statut == statut ? 'selected' }}>{{ statut.label }}</option>{% endfor %}</select></form><form method="post" action="{{ path('app_mes_jeux_retirer', {id: entree.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('retirer-bibliotheque-' ~ entree.id) }}"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Retirer</button></form></div></div></article></div>{% else %}<div class="col-12"><div class="gw-panel p-5 text-center"><i class="bi bi-controller display-4 text-primary"></i><h2 class="h4 mt-3">Ta bibliothèque est vide</h2><p class="text-secondary">Ajoute un jeu depuis sa fiche pour commencer.</p><a class="btn btn-primary" href="{{ path('app_jeux') }}">Découvrir les jeux</a></div></div>{% endfor %}</div></section>
        <section class="tab-pane fade" id="listes"><div class="row g-4"><div class="col-lg-4"><form class="gw-panel p-4" method="post" action="{{ path('app_liste_jeux_creer') }}"><h2 class="h5">Nouvelle liste</h2><input type="hidden" name="_token" value="{{ csrf_token('creer-liste') }}"><label class="form-label" for="liste-nom">Nom</label><input class="form-control mb-3" id="liste-nom" name="nom" maxlength="80" required><label class="form-label" for="liste-description">Description</label><textarea class="form-control mb-3" id="liste-description" name="description" maxlength="255"></textarea><button class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i> Créer la liste</button></form></div><div class="col-lg-8"><div class="row g-3">{% for liste in listes %}<div class="col-12"><article class="gw-panel p-4"><div class="d-flex justify-content-between"><div><h2 class="h5 mb-1">{{ liste.nom }}</h2><p class="text-secondary small">{{ liste.description ?: liste.jeux|length ~ ' jeu(x)' }}</p></div><form method="post" action="{{ path('app_liste_jeux_supprimer', {id: liste.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-liste-' ~ liste.id) }}"><button class="btn btn-sm btn-outline-danger" aria-label="Supprimer {{ liste.nom }}"><i class="bi bi-trash"></i></button></form></div><div class="d-flex flex-wrap gap-2 mb-3">{% for jeu in liste.jeux %}<span class="badge text-bg-primary-subtle text-primary-emphasis p-2">{{ jeu.nom }}</span>{% else %}<span class="text-secondary small">Liste vide</span>{% endfor %}</div>{% if bibliotheque is not empty %}<div class="dropdown"><button class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">Gérer les jeux</button><ul class="dropdown-menu">{% for entree in bibliotheque %}<li><form method="post" action="{{ path('app_liste_jeux_basculer', {id: liste.id, jeuId: entree.jeu.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('liste-' ~ liste.id ~ '-jeu-' ~ entree.jeu.id) }}"><button class="dropdown-item"><i class="bi bi-{{ liste.contient(entree.jeu) ? 'check-square-fill' : 'square' }} me-2"></i>{{ entree.jeu.nom }}</button></form></li>{% endfor %}</ul></div>{% endif %}</article></div>{% else %}<p class="text-secondary">Crée ta première liste personnalisée.</p>{% endfor %}</div></div></div></section>
        <section class="tab-pane fade" id="succes"><div class="row g-3">{% for item in succes %}{% set acquis = item.code in codesAcquis %}<div class="col-md-6 col-xl-4"><article class="gw-panel p-4 h-100 {{ not acquis ? 'opacity-50' }}"><div class="d-flex gap-3"><span class="gw-achievement text-bg-{{ item.couleur }}"><i class="bi bi-{{ acquis ? item.icone : 'lock-fill' }}"></i></span><div><div class="d-flex align-items-center gap-2"><h2 class="h5 mb-0">{{ item.nom }}</h2>{% if acquis %}<span class="badge text-bg-success">Débloqué</span>{% endif %}</div><p class="text-secondary my-2">{{ item.description }}</p><strong class="text-warning">+{{ item.points }} points</strong></div></div></article></div>{% endfor %}</div></section>
    </div>
</main>
{% endblock %}
