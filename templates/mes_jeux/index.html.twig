{% extends 'base.html.twig' %}
{% block title %}Mes jeux et succès - Glitchworlds{% endblock %}
{% block body %}
{% set onglet = app.request.query.get('onglet')|default('publiques') %}
{% set onglet = onglet in ['publiques', 'bibliotheque', 'listes', 'succes'] ? onglet : 'publiques' %}
<main class="container-fluid py-4">
    <header class="gw-page-heading mb-4"><div><span class="gw-eyebrow"><i class="bi bi-collection-play-fill"></i> Jeux et sélections</span><h1 class="display-5 fw-bold mb-1">Ma collection</h1><p class="text-secondary mb-0">Découvre les sélections de la communauté, suis ta progression et organise tes listes.</p></div><div class="gw-shop__balance"><i class="bi bi-star-fill"></i><span><strong>{{ app.user.points }}</strong> points</span></div></header>
    <ul class="nav nav-pills gw-library-tabs gap-2 mb-4" role="tablist"><li class="nav-item"><button class="nav-link{{ onglet == 'publiques' ? ' active' : '' }}" data-bs-toggle="tab" data-bs-target="#publiques" type="button">Listes</button></li><li class="nav-item"><button class="nav-link{{ onglet == 'listes' ? ' active' : '' }}" data-bs-toggle="tab" data-bs-target="#listes" type="button">Mes listes</button></li><li class="nav-item"><button class="nav-link{{ onglet == 'bibliotheque' ? ' active' : '' }}" data-bs-toggle="tab" data-bs-target="#bibliotheque" type="button">Bibliothèque <span class="badge text-bg-light ms-1">{{ bibliotheque|length }}</span></button></li><li class="nav-item"><button class="nav-link{{ onglet == 'succes' ? ' active' : '' }}" data-bs-toggle="tab" data-bs-target="#succes" type="button">Succès <span class="badge text-bg-warning ms-1">{{ succesAcquis|length }}/{{ succes|length }}</span></button></li></ul>
    <div class="tab-content">
        <section class="tab-pane fade{{ onglet == 'publiques' ? ' show active' : '' }}" id="publiques"><div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><h2 class="h4 mb-1">Listes publiques</h2><p class="text-secondary mb-0">Les dernières sélections partagées par la communauté.</p></div><a class="btn btn-outline-primary" href="{{ path('app_listes_publiques') }}">Voir toutes</a></div><form class="gw-search-box gw-list-search mb-4" method="get" action="{{ path('app_mes_jeux') }}" data-controller="recherche-autocomplete" data-recherche-autocomplete-url-value="{{ path('app_recherche_autocompletion', {type: 'liste'}) }}" data-recherche-autocomplete-target="formulaire"><input type="hidden" name="onglet" value="publiques"><label class="visually-hidden" for="recherche-listes-collection">Rechercher une liste</label><i class="bi bi-search" aria-hidden="true"></i><input class="form-control" id="recherche-listes-collection" type="search" name="q" value="{{ rechercheListes }}" maxlength="80" placeholder="Nom d’une liste, membre ou jeu…" autocomplete="off" aria-autocomplete="list" aria-controls="collection-listes-resultats" aria-expanded="false" data-recherche-autocomplete-target="champ" data-action="input->recherche-autocomplete#rechercher keydown->recherche-autocomplete#naviguer focus->recherche-autocomplete#rechercher"><div class="d-flex gap-2">{% if rechercheListes %}<a class="btn btn-outline-secondary" href="{{ path('app_mes_jeux') }}" aria-label="Effacer la recherche"><i class="bi bi-x-lg"></i></a>{% endif %}<button class="btn btn-gw" type="submit">Rechercher</button></div><div id="collection-listes-resultats" class="gw-autocomplete d-none" role="listbox" data-recherche-autocomplete-target="resultats"></div></form><div class="row g-3">{% for liste in listesPubliques %}{% set jeuxVisibles = liste.jeux|filter(jeu => jeu.statut.value == 'approuve') %}<div class="col-md-6 col-xl-4"><article class="gw-panel p-4 h-100"><div class="d-flex justify-content-between gap-2"><div><h3 class="h5 mb-1"><a class="text-decoration-none" href="{{ path('app_liste_publique', {slug: liste.slug, id: liste.id}) }}">{{ liste.nom }}</a></h3><a class="small text-secondary" href="{{ path('app_profil', {id: liste.utilisateur.id}) }}">par {{ liste.utilisateur.pseudo }}</a></div><span class="badge text-bg-primary align-self-start">{{ jeuxVisibles|length }} jeu{{ jeuxVisibles|length > 1 ? 'x' : '' }}</span></div>{% if liste.description %}<p class="small text-secondary mt-3 mb-2">{{ liste.description|extrait(120) }}</p>{% endif %}<div class="d-flex gap-2 mt-3">{% for jeu in jeuxVisibles|slice(0, 4) %}<span class="gw-custom-list__visual" title="{{ jeu.nom }}">{% if jeu.miniature starts with 'miniature.' %}<img src="{{ asset('uploads/jeux/' ~ jeu.id ~ '/' ~ jeu.miniature) }}" alt="{{ jeu.nom }}" loading="lazy">{% else %}<i class="bi bi-controller"></i>{% endif %}</span>{% else %}<span class="small text-secondary">Liste vide</span>{% endfor %}</div></article></div>{% else %}<div class="col-12"><div class="gw-panel p-5 text-center text-secondary">{{ rechercheListes ? 'Aucune liste ne correspond à cette recherche.' : 'Aucune liste publique pour le moment.' }}</div></div>{% endfor %}</div></section>
        <section class="tab-pane fade{{ onglet == 'bibliotheque' ? ' show active' : '' }}" id="bibliotheque"><div class="row g-3">{% for entree in bibliotheque %}<div class="col-md-6 col-xl-4"><article class="gw-panel p-3 h-100"><div class="d-flex gap-3"><span class="gw-bibliotheque-thumb">{% if entree.jeu.miniature starts with 'miniature.' %}<img src="{{ asset('uploads/jeux/' ~ entree.jeu.id ~ '/' ~ entree.jeu.miniature) }}" alt="" width="96" height="96" class="rounded-3 object-fit-cover" loading="lazy">{% else %}<span class="gw-bibliotheque-thumb__fallback"><i class="bi bi-controller"></i></span>{% endif %}{% include 'jeu/_note_badge.html.twig' with { note: notesJeux[entree.jeu.id]|default(null) } only %}</span><div class="flex-grow-1"><h2 class="h5"><a class="text-decoration-none" href="{{ path('app_jeu_show', {id: entree.jeu.id, slug: entree.jeu.slug}) }}">{{ entree.jeu.nom }}</a></h2><form method="post" action="{{ path('app_mes_jeux_ajouter', {id: entree.jeu.id}) }}" class="mb-2"><input type="hidden" name="_token" value="{{ csrf_token('bibliotheque-' ~ entree.jeu.id) }}"><select name="statut" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Progression pour {{ entree.jeu.nom }}">{% for statut in statuts %}<option value="{{ statut.value }}" {{ entree.statut == statut ? 'selected' }}>{{ statut.label }}</option>{% endfor %}</select></form><form method="post" action="{{ path('app_mes_jeux_retirer', {id: entree.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('retirer-bibliotheque-' ~ entree.id) }}"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Retirer</button></form></div></div></article></div>{% else %}<div class="col-12"><div class="gw-panel p-5 text-center"><i class="bi bi-controller display-4 text-primary"></i><h2 class="h4 mt-3">Ta bibliothèque est vide</h2><p class="text-secondary">Ajoute un jeu depuis sa fiche pour commencer.</p><a class="btn btn-primary" href="{{ path('app_jeux') }}">Découvrir les jeux</a></div></div>{% endfor %}</div></section>
        <section class="tab-pane fade{{ onglet == 'listes' ? ' show active' : '' }}" id="listes"><div class="row g-4">
            <div class="col-lg-4"><form class="gw-panel p-4" method="post" action="{{ path('app_liste_jeux_creer') }}"><h2 class="h5">Nouvelle liste</h2><input type="hidden" name="_token" value="{{ csrf_token('creer-liste') }}"><label class="form-label" for="liste-nom">Nom</label><input class="form-control mb-3" id="liste-nom" name="nom" maxlength="80" required><label class="form-label" for="liste-description">Description</label><textarea class="form-control mb-3" id="liste-description" name="description" maxlength="255"></textarea><fieldset class="mb-3"><legend class="form-label mb-2">Visibilité</legend><div class="d-flex gap-2"><input class="btn-check" type="radio" name="visibilite" id="liste-publique" value="publique" checked><label class="btn btn-outline-primary flex-fill" for="liste-publique"><i class="bi bi-globe2"></i> Publique</label><input class="btn-check" type="radio" name="visibilite" id="liste-privee" value="privee"><label class="btn btn-outline-secondary flex-fill" for="liste-privee"><i class="bi bi-lock-fill"></i> Privée</label></div><div class="form-text">Une liste publique est visible par tous et partageable.</div></fieldset><button class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i> Créer la liste</button></form></div>
            <div class="col-lg-8"><div class="row g-3">{% for liste in listes %}<div class="col-12"><article class="gw-panel p-4">
                <div class="d-flex justify-content-between gap-3"><div><div class="d-flex align-items-center flex-wrap gap-2 mb-1"><h2 class="h5 mb-0">{{ liste.nom }}</h2><span class="badge {{ liste.publique ? 'text-bg-success' : 'text-bg-secondary' }}">{{ liste.publique ? 'Publique' : 'Privée' }}</span></div><p class="text-secondary small mb-2">{{ liste.description ?: liste.jeux|length ~ ' jeu(x)' }}</p>{% if liste.publique and liste.slug %}<div class="d-flex flex-wrap align-items-center gap-2"><a class="small" href="{{ path('app_liste_publique', {slug: liste.slug, id: liste.id}) }}" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Voir la liste publique</a><button class="btn btn-sm btn-link p-0" type="button" data-copy-url="{{ url('app_liste_publique', {slug: liste.slug, id: liste.id}) }}"><i class="bi bi-link-45deg"></i> Copier le lien</button></div>{% endif %}</div><div class="d-flex align-items-start gap-2"><form method="post" action="{{ path('app_liste_jeux_partage', {id: liste.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('partage-liste-' ~ liste.id) }}"><button class="btn btn-sm {{ liste.publique ? 'btn-outline-secondary' : 'btn-outline-primary' }}">{{ liste.publique ? 'Rendre privée' : 'Rendre publique' }}</button></form><form method="post" action="{{ path('app_liste_jeux_supprimer', {id: liste.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-liste-' ~ liste.id) }}"><button class="btn btn-sm btn-outline-danger" aria-label="Supprimer {{ liste.nom }}"><i class="bi bi-trash"></i></button></form></div></div>
                <div class="gw-custom-list mb-3" data-controller="liste-classement" data-liste-classement-url-value="{{ path('app_liste_jeux_ordre', {id: liste.id}) }}" data-liste-classement-token-value="{{ csrf_token('liste-' ~ liste.id ~ '-ordre') }}">{% for jeu in liste.jeux %}<div class="gw-custom-list__game" data-jeu-id="{{ jeu.id }}">
                    <span class="gw-custom-list__rank" aria-label="Classement {{ loop.index }}"><span class="gw-custom-list__rank-value">{{ loop.index }}</span></span>
                    <a class="gw-custom-list__visual" href="{{ path('app_jeu_show', {id: jeu.id, slug: jeu.slug}) }}" aria-label="Voir {{ jeu.nom }}">{% if jeu.miniature starts with 'miniature.' %}<img src="{{ asset('uploads/jeux/' ~ jeu.id ~ '/' ~ jeu.miniature) }}" alt="" loading="lazy">{% else %}<i class="bi bi-controller"></i>{% endif %}</a>
                    <div class="flex-grow-1 min-w-0"><a class="fw-semibold text-decoration-none" href="{{ path('app_jeu_show', {id: jeu.id, slug: jeu.slug}) }}">{{ jeu.nom }}</a><div class="gw-custom-list__rating">{% if notesPersonnelles[jeu.id] is defined %}<i class="bi bi-star-fill"></i> Ma note : {{ notesPersonnelles[jeu.id]|number_format(1, ',', ' ') }}/5{% else %}<span class="text-secondary fw-normal">Non noté</span>{% endif %}</div></div>
                    <button class="gw-custom-list__drag-handle" type="button" data-action="keydown->liste-classement#deplacerAuClavier" aria-label="Déplacer {{ jeu.nom }}" title="Faire glisser pour déplacer"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button>
                    <form method="post" action="{{ path('app_liste_jeux_basculer', {id: liste.id, jeuId: jeu.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('liste-' ~ liste.id ~ '-jeu-' ~ jeu.id) }}"><button class="btn btn-sm btn-outline-danger" aria-label="Retirer {{ jeu.nom }} de {{ liste.nom }}"><i class="bi bi-x-lg"></i></button></form>
                </div>{% else %}<span class="text-secondary small">Cette liste est vide.</span>{% endfor %}</div>
                <form class="d-flex flex-column flex-sm-row gap-2" method="post" action="{{ path('app_liste_jeux_ajouter', {id: liste.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('liste-ajouter-' ~ liste.id) }}"><label class="visually-hidden" for="liste-{{ liste.id }}-jeu">Jeu à ajouter</label><select class="form-select form-select-sm" id="liste-{{ liste.id }}-jeu" name="jeu_id" required><option value="">Ajouter un jeu du catalogue…</option>{% for jeu in jeuxDisponibles %}{% if not liste.contient(jeu) %}<option value="{{ jeu.id }}">{{ jeu.nom }}</option>{% endif %}{% endfor %}</select><button class="btn btn-sm btn-outline-primary flex-shrink-0"><i class="bi bi-plus-lg"></i> Ajouter</button></form>
            </article></div>{% else %}<p class="text-secondary">Crée ta première liste personnalisée.</p>{% endfor %}</div></div>
        </div></section>
        <section class="tab-pane fade{{ onglet == 'succes' ? ' show active' : '' }}" id="succes">{{ include('_succes_groupes.html.twig', { succes: succes, codesAcquis: codesAcquis, colonnes: 'col-md-6 col-xl-4' }) }}</section>
    </div>
</main>
<script>
document.querySelectorAll('[data-copy-url]').forEach((button) => button.addEventListener('click', async () => {
    try {
        await navigator.clipboard.writeText(button.dataset.copyUrl);
        button.innerHTML = '<i class="bi bi-check-lg"></i> Lien copié';
    } catch (error) {
        window.prompt('Copiez le lien de la liste :', button.dataset.copyUrl);
    }
}));
</script>
{% endblock %}
