{% set format = format|default('auto') %}
{% set responsive = responsive|default(true) %}
<aside class="gw-ad my-4" aria-label="Publicité">
    <span class="gw-ad__label">Publicité</span>
    <ins class="adsbygoogle"
         data-controller="adsense"
         data-ad-client="ca-pub-1179428382006278"
         data-ad-slot="{{ slot }}"
         data-ad-format="{{ format }}"
         {% if layout is defined %}data-ad-layout="{{ layout }}"{% endif %}
         data-full-width-responsive="{{ responsive ? 'true' : 'false' }}"></ins>
</aside>
