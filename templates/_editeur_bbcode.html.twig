{# Éditeur BBCode réutilisable.
   Variables :
   - champ : FormView du textarea contenu
   - templates (optionnel) : 'jeu' ou 'actualite' pour afficher les modèles legacy
   - afficher_modeles_complets (optionnel, défaut true) #}
{% set modeles = templates is defined ? (templates == 'jeu'
    ? [
        { id: 'presentation_complete', label: 'Présentation complète', title: 'Insérer une fiche complète', mode: 'complet' },
        { id: 'presentation_pokemon', label: 'Présentation Pokémon', title: 'Insérer une présentation de jeu Pokémon', mode: 'complet' },
        { id: 'section_presentation', label: 'Présentation générale', title: 'Ajouter la présentation générale', mode: 'section' },
        { id: 'section_histoire', label: 'Histoire', title: 'Ajouter une rubrique Histoire', mode: 'section' },
        { id: 'section_avis', label: 'Avis', title: 'Ajouter une rubrique Avis', mode: 'section' },
        { id: 'section_fonctionnalites', label: 'Fonctionnalités', title: 'Ajouter les fonctionnalités', mode: 'section' },
        { id: 'section_gameplay', label: 'Gameplay', title: 'Ajouter le gameplay', mode: 'section' },
        { id: 'section_date_sortie', label: 'Date de sortie', title: 'Ajouter la date de sortie', mode: 'section' },
        { id: 'section_duree_vie', label: 'Durée de vie', title: 'Ajouter la durée de vie', mode: 'section' },
        { id: 'section_plateformes', label: 'Plateformes', title: 'Ajouter les plateformes', mode: 'section' },
        { id: 'section_langues', label: 'Langues', title: 'Ajouter les langues', mode: 'section' },
        { id: 'section_pokedex', label: 'Pokédex', title: 'Ajouter le Pokédex', mode: 'section' },
        { id: 'section_region', label: 'Région', title: 'Ajouter la région', mode: 'section' },
        { id: 'section_personnages', label: 'Personnages', title: 'Ajouter les personnages', mode: 'section' },
        { id: 'section_starters', label: 'Starters', title: 'Ajouter les starters', mode: 'section' },
        { id: 'section_difficulte', label: 'Difficulté', title: 'Ajouter la difficulté', mode: 'section' },
        { id: 'section_captures', label: 'Captures d’écran', title: 'Ajouter les captures d’écran', mode: 'section' },
        { id: 'section_trailer', label: 'Trailer et vidéos', title: 'Ajouter les vidéos', mode: 'section' },
        { id: 'section_telechargement', label: 'Téléchargement', title: 'Ajouter le téléchargement', mode: 'section' },
        { id: 'section_credits', label: 'Crédits', title: 'Ajouter les crédits', mode: 'section' }
    ]
    : (templates == 'actualite'
        ? [{ id: 'glitch', label: 'Glitch', title: 'Glitch' }]
        : [])) : [] %}
<div class="mb-3" data-controller="bbcode" data-bbcode-apercu-url-value="{{ path('app_bbcode_apercu') }}" data-bbcode-jeton-value="{{ csrf_token('apercu-bbcode') }}">
    {{ form_label(champ) }}
    {% if modeles is not empty %}
        <div class="mb-3" data-bbcode-target="groupeTemplates">
            {% if afficher_modeles_complets is not defined or afficher_modeles_complets %}
                <span class="form-label d-block mb-1">Modèle de contenu</span>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    {% for modele in modeles|filter(modele => modele.mode|default('complet') == 'complet') %}
                        <button class="btn btn-outline-primary btn-sm" type="button" title="{{ modele.title }}" data-bs-toggle="tooltip" data-bs-placement="top" data-action="bbcode#appliquerTemplate" data-bbcode-id-param="{{ modele.id }}" data-bbcode-mode-param="complet">{{ modele.label }}</button>
                    {% endfor %}
                </div>
                <div class="form-text">Un format complet remplit une fiche vide.</div>
            {% endif %}
            <span class="form-label d-block {{ afficher_modeles_complets is not defined or afficher_modeles_complets ? 'mt-3 ' : '' }}mb-1">Ajouter une partie</span>
            <div class="d-flex flex-wrap gap-2">
                <select class="form-select form-select-sm" data-action="change->bbcode#ajouterPartie" aria-label="Choisir une partie à ajouter">
                    <option value="">Choisir une partie…</option>
                    {% for modele in modeles|filter(modele => modele.mode|default('complet') == 'section') %}
                        <option value="{{ modele.id }}">{{ modele.label }}</option>
                    {% endfor %}
                </select>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-action="bbcode#ajouterPartiePersonnalisee">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Partie personnalisée
                </button>
            </div>
            <div class="form-text">Les parties s’insèrent à l’emplacement du curseur et peuvent être combinées librement.</div>
        </div>
    {% endif %}
    <div class="btn-toolbar gap-2 my-2 gw-bbcode-toolbar" role="toolbar" aria-label="Mise en forme BBCode">
        <div class="btn-group btn-group-sm" role="group" aria-label="Style du texte">
            <button class="btn btn-outline-secondary fw-bold" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[b]" data-bbcode-fermante-param="[/b]" title="Gras" data-bs-toggle="tooltip" data-bs-placement="top">B</button>
            <button class="btn btn-outline-secondary fst-italic" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[i]" data-bbcode-fermante-param="[/i]" title="Italique" data-bs-toggle="tooltip" data-bs-placement="top">I</button>
            <button class="btn btn-outline-secondary text-decoration-underline" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[u]" data-bbcode-fermante-param="[/u]" title="Souligner" data-bs-toggle="tooltip" data-bs-placement="top">U</button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[citation]" data-bbcode-fermante-param="[/citation]" title="Citation" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-quote" aria-hidden="true"></i></button>
        </div>

        <div class="btn-group btn-group-sm" role="group" aria-label="Alignement">
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[gauche]" data-bbcode-fermante-param="[/gauche]" title="Placer à gauche" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-text-left" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[center]" data-bbcode-fermante-param="[/center]" title="Placer au centre" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-text-center" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[droite]" data-bbcode-fermante-param="[/droite]" title="Placer à droite" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-text-right" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[gaucheFlottant]" data-bbcode-fermante-param="[/gaucheFlottant]" title="Alignement flottant à gauche" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-text-indent-left" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[droiteFlottant]" data-bbcode-fermante-param="[/droiteFlottant]" title="Alignement flottant à droite" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-text-indent-right" aria-hidden="true"></i></button>
        </div>

        <div class="btn-group btn-group-sm" role="group" aria-label="Éléments">
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#liste" title="Liste" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[elementliste]" data-bbcode-fermante-param="[/elementliste]" title="Élément de liste" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-list-check" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#lien" title="Lien" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-link-45deg" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#image" title="Image par lien" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-image" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#video" title="Vidéo" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-youtube" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[gallery]" data-bbcode-fermante-param="[/gallery]" title="Galerie d'image" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-images" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#tableau" title="Tableau" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-table" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-action="bbcode#encadrer" data-bbcode-ouvrante-param="[section]" data-bbcode-fermante-param="[/section]" title="Section" data-bs-toggle="tooltip" data-bs-placement="top"><i class="bi bi-layout-text-window" aria-hidden="true"></i></button>
        </div>

        <div class="gw-bbcode-emoji-wrap">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-action="bbcode#basculerEmojis" title="Insérer un emoji" data-bs-toggle="tooltip" data-bs-placement="top" aria-haspopup="dialog" aria-expanded="false">
                <i class="bi bi-emoji-smile" aria-hidden="true"></i><span class="visually-hidden">Insérer un emoji</span>
            </button>
            <div class="gw-bbcode-emoji-menu" data-bbcode-target="menuEmoji" role="dialog" aria-label="Choisir un emoji" hidden></div>
        </div>

        <select class="form-select form-select-sm w-auto" data-action="change->bbcode#choisir" data-bbcode-modele-ouvrant="[titre={valeur}]" data-bbcode-modele-fermant="[/titre]" aria-label="Niveau de titre">
            <option value="">Titre</option>{% for niveau in 1..5 %}<option value="h{{ niveau }}">H{{ niveau }}</option>{% endfor %}
        </select>
        <select class="form-select form-select-sm w-auto" data-action="change->bbcode#choisir" data-bbcode-modele-ouvrant="[taille={valeur}]" data-bbcode-modele-fermant="[/taille]" aria-label="Taille du texte">
            <option value="">Taille</option><option value="smaller">Très petite</option><option value="small">Petite</option><option value="medium">Moyenne</option><option value="large">Grande</option><option value="largest">Très grande</option>
        </select>
        <select class="form-select form-select-sm w-auto" data-action="change->bbcode#choisir" data-bbcode-modele-ouvrant="[couleur={valeur}]" data-bbcode-modele-fermant="[/couleur]" aria-label="Couleur du texte">
            <option value="">Couleur</option>{% for valeur, nom in { blue: 'Bleu', lightskyblue: 'Bleu clair', yellow: 'Jaune', green: 'Vert', orange: 'Orange', red: 'Rouge', pink: 'Rose', violet: 'Violet', brown: 'Marron', silver: 'Argenté' } %}<option value="{{ valeur }}">{{ nom }}</option>{% endfor %}
        </select>
        <select class="form-select form-select-sm w-auto" data-action="change->bbcode#choisir" data-bbcode-modele-ouvrant="[couleurfond={valeur}]" data-bbcode-modele-fermant="[/couleurfond]" aria-label="Couleur de fond">
            <option value="">Fond</option>{% for valeur, nom in { blue: 'Bleu', lightskyblue: 'Bleu clair', yellow: 'Jaune', green: 'Vert', orange: 'Orange', red: 'Rouge', pink: 'Rose', violet: 'Violet', brown: 'Marron', silver: 'Argenté' } %}<option value="{{ valeur }}">{{ nom }}</option>{% endfor %}
        </select>
        <select class="form-select form-select-sm w-auto" data-action="change->bbcode#choisir" data-bbcode-modele-ouvrant="[animation={valeur}]" data-bbcode-modele-fermant="[/animation]" aria-label="Animation">
            <option value="">Animation</option><option value="fade-up">Apparition vers le haut</option><option value="fade-down">Apparition vers le bas</option><option value="fade-left">Apparition vers la gauche</option><option value="fade-right">Apparition vers la droite</option><option value="zoom-in">Agrandissement</option><option value="zoom-out">Réduction</option>
        </select>
        <select class="form-select form-select-sm w-auto" data-action="change->bbcode#icone" aria-label="Icône">
            <option value="">Icône</option><option value="histoir.png">Histoire</option><option value="Important.png">Important</option><option value="pokedex-kanto.png">Pokédex</option><option value="iconemap.png">Carte</option><option value="iconetrailer.png">Bande-annonce</option><option value="iconetelechargement.png">Téléchargement</option><option value="iconecoupe.png">Crédits</option><option value="iconecapture.png">Captures d’écran</option><option value="français.png">Français</option><option value="anglais.png">Anglais</option><option value="iconewindows.png">Windows</option><option value="mac.png">macOS</option><option value="linux.png">Linux</option><option value="android.png">Android</option>
        </select>
    </div>

    <div class="d-flex justify-content-end mb-2">
        <button class="btn btn-sm btn-outline-primary" type="button" data-action="bbcode#basculerApercu" data-bbcode-target="boutonApercu" aria-expanded="false">
            <i class="bi bi-eye-fill me-1" aria-hidden="true"></i>Afficher l’aperçu
        </button>
    </div>
    {{ form_widget(champ, { attr: { rows: 18, 'data-bbcode-target': 'contenu', 'data-action': 'input->bbcode#planifierApercu' } }) }}
    {{ form_errors(champ) }}
    {{ form_help(champ) }}
    <section class="gw-bbcode-preview d-none mt-3" data-bbcode-target="apercu" aria-live="polite">
        <div class="d-flex align-items-center gap-2 border-bottom pb-2 mb-3"><i class="bi bi-eye-fill text-primary" aria-hidden="true"></i><strong>Aperçu du contenu</strong></div>
        <div data-bbcode-target="rendu"></div>
    </section>
</div>
