{% extends 'base.html.twig' %}

{% block title %}Modifier un commentaire - {{ commentaire.jeu.nom }} - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}

{% block body %}
<section class="gw-panel p-4 p-md-5 mx-auto" style="max-width: 760px">
    <nav aria-label="Fil d’Ariane">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_jeu_show', { slug: commentaire.jeu.slug, id: commentaire.jeu.id }) }}#commentaires">{{ commentaire.jeu.nom }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modifier le commentaire</li>
        </ol>
    </nav>

    <h1 class="h2">Modifier un commentaire</h1>

    {{ form_start(formulaire) }}
        {% include '_editeur_commentaire.html.twig' with { champ: formulaire.contenu } only %}
        <div class="d-flex flex-wrap gap-2">
            {{ form_widget(formulaire.publier) }}
            <a class="btn btn-outline-secondary" href="{{ app.request.query.get('retour') == 'moderation' ? path('app_moderation_commentaires') : path('app_jeu_show', { slug: commentaire.jeu.slug, id: commentaire.jeu.id }) ~ '#commentaires' }}">Annuler</a>
        </div>
    {{ form_end(formulaire) }}
</section>
{% endblock %}
