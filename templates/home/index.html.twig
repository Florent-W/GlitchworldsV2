{% extends 'base.html.twig' %}

{% block title %}Glitchworlds | Le site des Glitchs et des Fan Games{% endblock %}
{% block meta_description %}Découvre les fangames, hacks et créations de la communauté Glitchworlds.{% endblock %}

{% block body %}
<div class="gw-home-shell gw-disposition gw-disposition--grille" data-controller="disposition" data-disposition-mode="grille">
    <div class="gw-3ds-screen gw-3ds-screen--top">
        <section class="gw-game-hero gw-game-hero--home mb-4">
            <div class="gw-game-hero__content">
                <span class="gw-game-hero__category"><i class="bi bi-broadcast me-1" aria-hidden="true"></i>Glitchworlds</span>
                <h1>Play. Hack. Rewrite Reality.</h1>
                <p class="gw-game-hero__lead">Explore des fangames, partage tes découvertes et construis ta collection avec la communauté.</p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a class="btn btn-light btn-lg" href="{{ path('app_jeux') }}"><i class="bi bi-controller me-2" aria-hidden="true"></i>Découvrir les jeux</a>
                    <a class="btn btn-outline-light btn-lg" href="{{ path('app_actualites_glitchs') }}"><i class="bi bi-lightning-charge-fill me-2" aria-hidden="true"></i>Explorer les glitchs</a>
                    {% if not app.user %}<a class="btn btn-outline-light btn-lg" href="{{ path('app_inscription') }}">Rejoindre la communauté</a>{% endif %}
                </div>
                <ul class="gw-game-hero__stats" aria-label="Glitchworlds en chiffres">
                    <li><strong>{{ totalJeux }}</strong><span>jeux</span></li>
                    <li><strong>{{ totalMembres }}</strong><span>membres</span></li>
                    <li><strong>{{ totalCommentaires }}</strong><span>commentaires</span></li>
                </ul>
            </div>
            <i class="bi bi-globe2 gw-game-hero__icon" aria-hidden="true"></i>
        </section>

        {% if actualitesMisesEnAvant is not empty %}
        <section id="actualites-en-avant" class="carousel slide gw-panel overflow-hidden mb-4" data-bs-ride="carousel" aria-label="Actualités mises en avant">
            {% if actualitesMisesEnAvant|length > 1 %}<div class="carousel-indicators">{% for actualite in actualitesMisesEnAvant %}<button type="button" data-bs-target="#actualites-en-avant" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" aria-current="{{ loop.first ? 'true' : 'false' }}" aria-label="Actualité {{ loop.index }}"></button>{% endfor %}</div>{% endif %}
            <div class="carousel-inner">
                {% for actualite in actualitesMisesEnAvant %}
                    <article class="carousel-item{{ loop.first ? ' active' : '' }} position-relative">
                        {% if actualite.fichierVignetteListe %}
                            {% include '_image_responsive.html.twig' with {
                                fichier: actualite.fichierVignetteListe,
                                dossier: 'uploads/actualites/' ~ actualite.id,
                                classes: 'd-block w-100 object-fit-cover',
                                style: 'height: clamp(260px, 42vw, 480px)',
                                alt: '',
                                loading: loop.first ? 'eager' : 'lazy',
                                fetchpriority: loop.first,
                                sizes: '100vw'
                            } only %}
                        {% else %}<div class="bg-primary-subtle" style="height: clamp(260px, 42vw, 480px)"></div>{% endif %}
                        <div class="carousel-caption text-start bg-dark bg-opacity-75 rounded-4 p-3 p-md-4 mb-3"><span class="badge text-bg-primary mb-2">{{ actualite.categorie.label }}</span><h2 class="h3">{{ actualite.titre }}</h2><p class="d-none d-md-block">{{ actualite.description }}</p><a class="btn btn-light" href="{{ path('app_actualite_voir', {slug: actualite.slug, id: actualite.id}) }}">Lire l’actualité</a></div>
                    </article>
                {% endfor %}
            </div>
            {% if actualitesMisesEnAvant|length > 1 %}<button class="carousel-control-prev" type="button" data-bs-target="#actualites-en-avant" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Précédente</span></button><button class="carousel-control-next" type="button" data-bs-target="#actualites-en-avant" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Suivante</span></button>{% endif %}
        </section>
        {% endif %}
    </div>

    <div class="gw-3ds-charniere" aria-hidden="true"></div>

    <div class="gw-3ds-screen gw-3ds-screen--bottom" data-controller="home-order">
        {% if populaires is not empty or nouveautes is not empty or dernieresActualites is not empty or derniersGlitchs is not empty %}
            <div class="d-flex flex-wrap justify-content-end gap-2 mb-3 gw-home-disposition">
                <button type="button" class="btn btn-sm btn-outline-secondary gw-home-organize-button" data-action="home-order#basculerMode" aria-pressed="false">
                    <i class="bi bi-arrows-move" aria-hidden="true"></i><span> Réorganiser</span>
                </button>
                {% include '_disposition_boutons.html.twig' with { label: 'Disposition des jeux et actualités', carrousel: true } only %}
            </div>
        {% endif %}

        {% macro listeJeux(cle, titre, icone, jeux, notes, commentairesJeux) %}
            {% if jeux is not empty %}
                <section class="gw-panel p-4 mb-4 gw-home-menu gw-home-sortable-section" data-home-section="{{ cle }}" data-controller="home-carousel">
                    <div class="gw-home-menu__entete d-flex justify-content-between align-items-center gap-3 mb-3">
                        <h2 class="h4 mb-0"><i class="bi bi-{{ icone }} text-primary me-2" aria-hidden="true"></i>{{ titre }}</h2>
                        <div class="d-flex align-items-center gap-2">
                            <a class="gw-home-menu__lien" href="{{ path('app_jeux') }}">Voir tout</a>
                            <button class="gw-home-order-button gw-home-order-button--up" type="button" aria-label="Monter la section {{ titre }}" title="Monter" data-action="home-order#monter"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                            <button class="gw-home-order-button gw-home-order-button--down" type="button" aria-label="Descendre la section {{ titre }}" title="Descendre" data-action="home-order#descendre"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                            <button class="gw-home-drag-handle" type="button" aria-label="Déplacer la section {{ titre }}" title="Faire glisser pour déplacer" data-action="keydown->home-order#deplacerAuClavier"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <div class="gw-home-carousel__stage">
                        <button class="gw-home-carousel__arrow gw-home-carousel__arrow--previous" type="button" data-home-carousel-target="precedent" data-action="home-carousel#precedent" aria-label="Afficher les jeux précédents"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 gw-collection gw-collection--jeux" data-home-carousel-target="piste">
                        {% for jeu in jeux %}
                            <div class="col">
                                {% include 'jeu/_carte.html.twig' with { jeu: jeu, note: notes[jeu.id]|default(null), nombreCommentaires: commentairesJeux[jeu.id]|default(0) } only %}
                            </div>
                        {% endfor %}
                    </div>
                        <button class="gw-home-carousel__arrow gw-home-carousel__arrow--next" type="button" data-home-carousel-target="suivant" data-action="home-carousel#suivant" aria-label="Afficher les jeux suivants"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </section>
            {% endif %}
        {% endmacro %}

        {{ _self.listeJeux('populaires', 'Jeux populaires', 'star-fill', populaires, notesJeux, commentairesJeux) }}
        {{ _self.listeJeux('nouveautes', 'Nouveautés', 'stars', nouveautes, notesJeux, commentairesJeux) }}

        {% macro listeActualites(cle, titre, icone, actualites, lienVoirTout, commentairesActualites) %}
            {% if actualites is not empty %}
                <section class="gw-panel p-4 mb-4 gw-home-menu gw-home-sortable-section" data-home-section="{{ cle }}" data-controller="home-carousel">
                    <div class="gw-home-menu__entete d-flex justify-content-between align-items-center gap-3 mb-3">
                        <h2 class="h4 mb-0"><i class="bi bi-{{ icone }} text-primary me-2" aria-hidden="true"></i>{{ titre }}</h2>
                        <div class="d-flex align-items-center gap-2">
                            <a class="gw-home-menu__lien" href="{{ lienVoirTout }}">Voir tout</a>
                            <button class="gw-home-order-button gw-home-order-button--up" type="button" aria-label="Monter la section {{ titre }}" title="Monter" data-action="home-order#monter"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                            <button class="gw-home-order-button gw-home-order-button--down" type="button" aria-label="Descendre la section {{ titre }}" title="Descendre" data-action="home-order#descendre"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                            <button class="gw-home-drag-handle" type="button" aria-label="Déplacer la section {{ titre }}" title="Faire glisser pour déplacer" data-action="keydown->home-order#deplacerAuClavier"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button>
                        </div>
                    </div>
            <div class="gw-home-carousel__stage">
                <button class="gw-home-carousel__arrow gw-home-carousel__arrow--previous" type="button" data-home-carousel-target="precedent" data-action="home-carousel#precedent" aria-label="Afficher les actualités précédentes"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 gw-collection gw-collection--actualites" data-home-carousel-target="piste">
                {% for actualite in actualites %}
                    <div class="col">
                        {% include 'actualite/_carte_accueil.html.twig' with { actualite: actualite, nombreCommentaires: commentairesActualites[actualite.id]|default(0) } only %}
                    </div>
                {% endfor %}
            </div>
                <button class="gw-home-carousel__arrow gw-home-carousel__arrow--next" type="button" data-home-carousel-target="suivant" data-action="home-carousel#suivant" aria-label="Afficher les actualités suivantes"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </div>
                </section>
            {% endif %}
        {% endmacro %}

        {{ _self.listeActualites('actualites', 'Dernières actualités', 'newspaper', dernieresActualites, path('app_actualites'), commentairesActualites) }}
        {{ _self.listeActualites('glitchs', 'Derniers glitchs', 'lightning-charge-fill', derniersGlitchs, path('app_actualites_glitchs'), commentairesActualites) }}

        {% if activiteRecente is not empty or nouveauxMembres is not empty %}
            <section class="gw-panel p-4 mb-4 gw-home-menu gw-home-menu--communaute gw-home-sortable-section" data-home-section="communaute" aria-labelledby="activite-communaute-title">
                <div class="gw-home-menu__entete d-flex justify-content-between align-items-center gap-3 mb-3">
                    <h2 id="activite-communaute-title" class="h4 mb-0"><i class="bi bi-people-fill text-primary me-2" aria-hidden="true"></i>Activité de la communauté</h2>
                    <div class="d-flex align-items-center gap-2">
                        <a class="gw-home-menu__lien" href="{{ path('app_communaute') }}">Voir la communauté</a>
                        <button class="gw-home-order-button gw-home-order-button--up" type="button" aria-label="Monter la section Activité de la communauté" title="Monter" data-action="home-order#monter"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                        <button class="gw-home-order-button gw-home-order-button--down" type="button" aria-label="Descendre la section Activité de la communauté" title="Descendre" data-action="home-order#descendre"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                        <button class="gw-home-drag-handle" type="button" aria-label="Déplacer la section Activité de la communauté" title="Faire glisser pour déplacer" data-action="keydown->home-order#deplacerAuClavier"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="row g-4">
                    {% if activiteRecente is not empty %}
                        <div class="col-lg-7">
                            <h3 class="h6 text-secondary text-uppercase mb-3" style="letter-spacing: .06em">Derniers commentaires</h3>
                            <ul class="gw-activity list-unstyled mb-0">
                                {% for item in activiteRecente %}
                                    <li class="gw-activity__item">
                                        <span class="gw-activity__avatar" aria-hidden="true">
                                            {% if item.auteur and item.auteur.avatar starts with 'avatar.' %}
                                                <img src="{{ asset('uploads/utilisateurs/' ~ item.auteur.id ~ '/' ~ item.auteur.avatar) }}" alt="" loading="lazy">
                                            {% else %}
                                                {{ item.auteur ? item.auteur.pseudo|first|upper : '?' }}
                                            {% endif %}
                                        </span>
                                        <div class="gw-activity__body">
                                            <p class="mb-1">
                                                <strong>{{ item.auteur ? item.auteur.pseudo : 'Membre' }}</strong>
                                                a commenté
                                                <a href="{{ item.url }}">{{ item.cible }}</a>
                                                <span class="gw-activity__type">{{ item.type == 'jeu' ? 'Jeu' : 'Actu' }}</span>
                                            </p>
                                            <p class="gw-activity__extrait mb-1">« {{ item.extrait }} »</p>
                                            <time class="small text-secondary" datetime="{{ item.date|date('c') }}">{{ item.date|format_datetime('medium', 'short', locale='fr') }}</time>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                    {% if nouveauxMembres is not empty %}
                        <div class="col-lg-{{ activiteRecente is not empty ? '5' : '12' }}">
                            <h3 class="h6 text-secondary text-uppercase mb-3" style="letter-spacing: .06em">Nouveaux membres</h3>
                            <ul class="gw-members list-unstyled mb-0">
                                {% for membre in nouveauxMembres %}
                                    <li>
                                        <a class="gw-members__item" href="{{ path('app_profil', { id: membre.id }) }}">
                                            <span class="gw-activity__avatar" aria-hidden="true">
                                                {% if membre.avatar starts with 'avatar.' %}
                                                    <img src="{{ asset('uploads/utilisateurs/' ~ membre.id ~ '/' ~ membre.avatar) }}" alt="" loading="lazy">
                                                {% else %}
                                                    {{ membre.pseudo|first|upper }}
                                                {% endif %}
                                            </span>
                                            <span class="gw-members__meta">
                                                <strong>{{ membre.pseudo }}</strong>
                                                <span class="small text-secondary">Inscrit le {{ membre.inscritLe|date('d/m/Y') }}</span>
                                            </span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </section>
        {% endif %}
    </div>
</div>
{% endblock %}
