<div class="btn-group btn-group-sm" role="group" aria-label="{{ label|default('Disposition') }}">
    <button type="button" class="btn btn-outline-secondary active" data-disposition-target="boutonGrille" data-action="disposition#choisirGrille" aria-pressed="true" title="3 par ligne">
        <i class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></i><span class="visually-hidden">3 par ligne</span>
    </button>
    <button type="button" class="btn btn-outline-secondary" data-disposition-target="boutonDouble" data-action="disposition#choisirDouble" aria-pressed="false" title="2 par colonne">
        <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i><span class="visually-hidden">2 par colonne</span>
    </button>
    <button type="button" class="btn btn-outline-secondary" data-disposition-target="boutonListe" data-action="disposition#choisirListe" aria-pressed="false" title="Vue en liste">
        <i class="bi bi-list-ul" aria-hidden="true"></i><span class="visually-hidden">Liste</span>
    </button>
</div>
