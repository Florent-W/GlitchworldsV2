{# Navigation précédent / suivant + raccourcis clavier ← → (Stimulus navigation-sequentielle).
   Variables :
   - label (string) : libellé aria de la barre
   - precedent, suivant (?object) : entités avec slug, id, titre affiché
   - route (string) : nom de route Symfony
   - type ('jeu'|'actualite') : visuel de la vignette
   - sens_precedent, sens_suivant (string) : libellés
   - son_survol (string) : data-son-survol optionnel #}
{% macro visuel(type, entite) %}
    {% if type == 'jeu' %}
        {% if entite.miniature starts with 'miniature.' %}
            <img src="{{ asset('uploads/jeux/' ~ entite.id ~ '/' ~ entite.miniature) }}" alt="" loading="lazy" decoding="async">
        {% else %}
            <i class="bi bi-controller" aria-hidden="true"></i>
        {% endif %}
    {% else %}
        {% if entite.miniature and not (entite.miniature starts with 'legacy:') %}
            <img src="{{ asset('uploads/actualites/' ~ entite.id ~ '/' ~ entite.miniature) }}" alt="" loading="lazy" decoding="async">
        {% else %}
            <i class="bi bi-newspaper" aria-hidden="true"></i>
        {% endif %}
    {% endif %}
{% endmacro %}

{% if precedent or suivant %}
    <nav class="gw-jeu-nav mt-4" aria-label="{{ label }}" data-controller="navigation-sequentielle" data-action="keydown@window->navigation-sequentielle#naviguerClavier">
        {% if precedent %}
            <a class="gw-jeu-nav__link gw-jeu-nav__link--prev" href="{{ path(route, { slug: precedent.slug, id: precedent.id }) }}" rel="prev"{% if son_survol is defined %} data-son-survol="{{ son_survol }}"{% endif %}>
                <span class="gw-jeu-nav__visual">
                    {{ _self.visuel(type, precedent) }}
                </span>
                <span class="gw-jeu-nav__texte">
                    <span class="gw-jeu-nav__sens"><i class="bi bi-chevron-left" aria-hidden="true"></i> {{ sens_precedent }}</span>
                    <strong class="gw-jeu-nav__titre">{{ type == 'jeu' ? precedent.nom : precedent.titre }}</strong>
                </span>
            </a>
        {% else %}
            <span></span>
        {% endif %}

        {% if suivant %}
            <a class="gw-jeu-nav__link gw-jeu-nav__link--next" href="{{ path(route, { slug: suivant.slug, id: suivant.id }) }}" rel="next"{% if son_survol is defined %} data-son-survol="{{ son_survol }}"{% endif %}>
                <span class="gw-jeu-nav__texte">
                    <span class="gw-jeu-nav__sens">{{ sens_suivant }} <i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                    <strong class="gw-jeu-nav__titre">{{ type == 'jeu' ? suivant.nom : suivant.titre }}</strong>
                </span>
                <span class="gw-jeu-nav__visual">
                    {{ _self.visuel(type, suivant) }}
                </span>
            </a>
        {% else %}
            <span></span>
        {% endif %}
    </nav>
{% endif %}
