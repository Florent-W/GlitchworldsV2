{% extends 'base.html.twig' %}

{% block title %}Modération des commentaires - GlitchWorlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}

{% block body %}
<div class="gw-admin">
    <aside>{% include 'moderation/_navigation.html.twig' %}</aside>
    <section class="min-w-0">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-chat-square-dots-fill text-primary fs-1" aria-hidden="true"></i>
            <div><span class="gw-eyebrow">Modération</span><h1 class="h2 mb-1">Commentaires et avis</h1><p class="text-secondary mb-0">Modère les commentaires, leurs réponses et les avis laissés sur les jeux.</p></div>
        </div>
    </div>

    <ul class="nav nav-pills mb-4" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link{{ ongletActif == 'jeux' ? ' active' : '' }}" id="jeux-tab" data-bs-toggle="tab" data-bs-target="#commentaires-jeux" type="button" role="tab">Jeux <span class="badge text-bg-light ms-1">{{ commentairesJeux|length }}</span></button></li>
        <li class="nav-item" role="presentation"><button class="nav-link{{ ongletActif == 'actualites' ? ' active' : '' }}" id="actualites-tab" data-bs-toggle="tab" data-bs-target="#commentaires-actualites" type="button" role="tab">Actualités <span class="badge text-bg-light ms-1">{{ commentairesActualites|length }}</span></button></li>
        <li class="nav-item" role="presentation"><button class="nav-link{{ ongletActif == 'avis' ? ' active' : '' }}" id="avis-tab" data-bs-toggle="tab" data-bs-target="#avis-jeux" type="button" role="tab">Avis <span class="badge text-bg-light ms-1">{{ avisJeux|length }}</span></button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade{{ ongletActif == 'jeux' ? ' show active' : '' }}" id="commentaires-jeux" role="tabpanel" aria-labelledby="jeux-tab" tabindex="0">
            <div class="vstack gap-3">
                {% for commentaire in commentairesJeux %}
                    <article class="border rounded-4 p-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                            <div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2"><strong>{{ commentaire.auteur ? commentaire.auteur.pseudo : 'Membre supprimé' }}</strong>{% if commentaire.parent %}<span class="badge text-bg-info">Réponse</span>{% endif %}<time class="small text-secondary" datetime="{{ commentaire.dateCommentaire|date('c') }}">{{ commentaire.dateCommentaire|format_datetime('medium', 'short', locale='fr') }}</time></div>
                                <p class="mb-2">{{ commentaire.contenu|nl2br }}</p>
                                <a class="small" href="{{ path('app_jeu_show', { slug: commentaire.jeu.slug, id: commentaire.jeu.id }) }}#commentaire-{{ commentaire.parent ? commentaire.parent.id : commentaire.id }}"><i class="bi bi-controller me-1" aria-hidden="true"></i>{{ commentaire.jeu.nom }}</a>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_commentaire_modifier', { id: commentaire.id, retour: 'moderation' }) }}"><i class="bi bi-pencil-fill me-1" aria-hidden="true"></i>Modifier</a>
                                <form method="post" action="{{ path('app_commentaire_supprimer', { id: commentaire.id }) }}" onsubmit="return confirm('Supprimer ce commentaire ?')"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-commentaire-' ~ commentaire.id) }}"><input type="hidden" name="_retour" value="moderation"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash-fill me-1" aria-hidden="true"></i>Supprimer</button></form>
                            </div>
                        </div>
                    </article>
                {% else %}<div class="alert alert-success mb-0">Aucun commentaire de jeu.</div>{% endfor %}
            </div>
        </div>

        <div class="tab-pane fade{{ ongletActif == 'actualites' ? ' show active' : '' }}" id="commentaires-actualites" role="tabpanel" aria-labelledby="actualites-tab" tabindex="0">
            <div class="vstack gap-3">
                {% for commentaire in commentairesActualites %}
                    <article class="border rounded-4 p-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                            <div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2"><strong>{{ commentaire.auteur ? commentaire.auteur.pseudo : 'Membre supprimé' }}</strong>{% if commentaire.parent %}<span class="badge text-bg-info">Réponse</span>{% endif %}<time class="small text-secondary" datetime="{{ commentaire.dateCommentaire|date('c') }}">{{ commentaire.dateCommentaire|format_datetime('medium', 'short', locale='fr') }}</time></div>
                                <p class="mb-2">{{ commentaire.contenu|nl2br }}</p>
                                <a class="small" href="{{ path('app_actualite_voir', { slug: commentaire.actualite.slug, id: commentaire.actualite.id }) }}#commentaire-{{ commentaire.parent ? commentaire.parent.id : commentaire.id }}"><i class="bi bi-newspaper me-1" aria-hidden="true"></i>{{ commentaire.actualite.titre }}</a>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_actualite_commentaire_modifier', { id: commentaire.id, retour: 'moderation' }) }}"><i class="bi bi-pencil-fill me-1" aria-hidden="true"></i>Modifier</a>
                                <form method="post" action="{{ path('app_actualite_commentaire_supprimer', { id: commentaire.id }) }}" onsubmit="return confirm('Supprimer ce commentaire ?')"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-commentaire-actualite-' ~ commentaire.id) }}"><input type="hidden" name="_retour" value="moderation"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash-fill me-1" aria-hidden="true"></i>Supprimer</button></form>
                            </div>
                        </div>
                    </article>
                {% else %}<div class="alert alert-success mb-0">Aucun commentaire d’actualité.</div>{% endfor %}
            </div>
        </div>

        <div class="tab-pane fade{{ ongletActif == 'avis' ? ' show active' : '' }}" id="avis-jeux" role="tabpanel" aria-labelledby="avis-tab" tabindex="0">
            <div class="vstack gap-3">
                {% for avis in avisJeux %}
                    <article class="border rounded-4 p-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                            <div class="min-w-0">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <strong>{{ avis.auteur ? avis.auteur.pseudo : 'Membre supprimé' }}</strong>
                                    <span class="badge text-bg-warning"><i class="bi bi-star-fill me-1" aria-hidden="true"></i>{{ avis.note|number_format(0) }}/5</span>
                                    <time class="small text-secondary" datetime="{{ avis.dateAvis|date('c') }}">{{ avis.dateAvis|format_datetime('medium', 'short', locale='fr') }}</time>
                                </div>
                                {% if avis.contenu is not empty %}<p class="mb-2">{{ avis.contenu|nl2br }}</p>{% else %}<p class="text-secondary fst-italic mb-2">Note sans avis écrit.</p>{% endif %}
                                {% if avis.jeu %}<a class="small" href="{{ path('app_jeu_show', { slug: avis.jeu.slug, id: avis.jeu.id }) }}#avis-joueurs"><i class="bi bi-controller me-1" aria-hidden="true"></i>{{ avis.jeu.nom }}</a>{% endif %}
                            </div>
                            <div class="d-flex align-items-start">
                                <a class="btn btn-sm btn-outline-primary me-2" href="{{ path('app_moderation_avis_modifier', { id: avis.id }) }}"><i class="bi bi-pencil-fill me-1" aria-hidden="true"></i>Modifier</a>
                                <form method="post" action="{{ path('app_moderation_avis_supprimer', { id: avis.id }) }}" onsubmit="return confirm('Supprimer cette note et cet avis ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-avis-' ~ avis.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash-fill me-1" aria-hidden="true"></i>Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </article>
                {% else %}<div class="alert alert-success mb-0">Aucun avis de jeu.</div>{% endfor %}
            </div>
        </div>
    </div>
    </section>
</div>
{% endblock %}
