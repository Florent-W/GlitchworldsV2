{% extends 'base.html.twig' %}
{% block title %}Signalements - Modération - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body %}
<div class="gw-admin">
    <aside>{% include 'moderation/_navigation.html.twig' %}</aside>
    <section class="min-w-0">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
            <div><span class="gw-eyebrow">Modération</span><h1 class="display-6 fw-bold mb-0">Signalements</h1></div>
            <form method="get"><select class="form-select" name="statut" onchange="this.form.submit()"><option value="">Tous les signalements</option>{% for statut in statuts %}<option value="{{ statut.value }}" {{ statutSelectionne == statut ? 'selected' }}>{{ statut.label }}</option>{% endfor %}</select></form>
        </div>
        <div class="vstack gap-3">
            {% for signalement in signalements %}
                <article class="gw-panel p-4">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                        <div class="min-w-0">
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <span class="badge text-bg-danger"><i class="bi bi-flag-fill me-1"></i>{{ signalement.motif.label }}</span>
                                <span class="badge text-bg-secondary">{{ signalement.typeCible }}</span>
                                <span class="badge text-bg-{{ signalement.statut.value == 'en_attente' ? 'warning' : (signalement.statut.value == 'traite' ? 'success' : 'secondary') }}">{{ signalement.statut.label }}</span>
                            </div>
                            <h2 class="h5 text-break">{{ signalement.extraitCible }}</h2>
                            {% if signalement.details %}<p class="mb-2">{{ signalement.details }}</p>{% endif %}
                            <small class="text-secondary">Signalé par {{ signalement.signalePar ? signalement.signalePar.pseudo : 'Compte supprimé' }} le {{ signalement.signaleLe|format_datetime('medium', 'short', locale='fr') }}</small>
                            <div class="mt-3">
                                {% if signalement.profil %}<a class="btn btn-sm btn-outline-primary" href="{{ path('app_profil', {id: signalement.profil.id}) }}">Voir le profil</a>{% endif %}
                                {% if signalement.avis and signalement.avis.jeu %}<a class="btn btn-sm btn-outline-primary" href="{{ path('app_jeu_show', {slug: signalement.avis.jeu.slug, id: signalement.avis.jeu.id}) }}#avis-joueurs">Voir l’avis</a>{% endif %}
                                {% if signalement.message and signalement.message.conversation %}<span class="badge text-bg-light border">Conversation privée #{{ signalement.message.conversation.id }}</span>{% endif %}
                            </div>
                        </div>
                        {% if signalement.statut.value == 'en_attente' %}
                            <div class="d-flex flex-wrap align-items-start gap-2">
                                {% if signalement.commentaireJeu or signalement.commentaireActualite or signalement.publication or signalement.avis or signalement.message %}
                                    <form method="post" action="{{ path('app_moderation_signalement_decider', {id: signalement.id, decision: 'supprimer'}) }}" onsubmit="return confirm('Supprimer ce contenu ?')"><input type="hidden" name="_token" value="{{ csrf_token('signalement-' ~ signalement.id) }}"><button class="btn btn-danger"><i class="bi bi-trash-fill me-1"></i>Supprimer le contenu</button></form>
                                {% endif %}
                                <form method="post" action="{{ path('app_moderation_signalement_decider', {id: signalement.id, decision: 'traiter'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('signalement-' ~ signalement.id) }}"><button class="btn btn-success">Marquer traité</button></form>
                                <form method="post" action="{{ path('app_moderation_signalement_decider', {id: signalement.id, decision: 'rejeter'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('signalement-' ~ signalement.id) }}"><button class="btn btn-outline-secondary">Rejeter</button></form>
                            </div>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <div class="gw-panel p-5 text-center text-secondary"><i class="bi bi-check-circle fs-1 d-block mb-2"></i>Aucun signalement dans cette catégorie.</div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
