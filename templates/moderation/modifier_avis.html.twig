{% extends 'base.html.twig' %}

{% block title %}Modifier un avis - Modération - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}

{% block body %}
    <div class="gw-page-shell gw-page-shell--narrow">
        <section class="gw-panel p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <i class="bi bi-pencil-square text-primary fs-1" aria-hidden="true"></i>
                <div>
                    <span class="gw-eyebrow">Modération</span>
                    <h1 class="h3 mb-1">Modifier l’avis</h1>
                    <p class="text-secondary mb-0">
                        {{ avis.auteur ? avis.auteur.pseudo : 'Membre supprimé' }} sur {{ avis.jeu ? avis.jeu.nom : 'un jeu supprimé' }}
                    </p>
                </div>
            </div>

            {{ form_start(formulaire) }}
                {{ form_row(formulaire.note) }}
                {{ form_row(formulaire.contenu) }}
                <div class="d-flex flex-wrap gap-2">
                    {{ form_widget(formulaire.enregistrer, { label: 'Enregistrer les modifications' }) }}
                    {% if retour == 'fiche' and avis.jeu %}
                        <a class="btn btn-outline-secondary" href="{{ path('app_jeu_show', { slug: avis.jeu.slug, id: avis.jeu.id }) }}#avis-joueurs">Annuler</a>
                    {% else %}
                        <a class="btn btn-outline-secondary" href="{{ path('app_moderation_commentaires', { onglet: 'avis' }) }}">Annuler</a>
                    {% endif %}
                </div>
            {{ form_end(formulaire) }}
        </section>
    </div>
{% endblock %}
