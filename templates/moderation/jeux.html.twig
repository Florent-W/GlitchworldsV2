{% extends 'base.html.twig' %}
{% block title %}Jeux - Modération - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body %}
<div class="gw-admin"><aside>{% include 'moderation/_navigation.html.twig' %}</aside><section class="min-w-0">
    <div class="d-flex align-items-center gap-3 mb-4"><i class="bi bi-controller text-primary fs-1"></i><div><span class="gw-eyebrow">Modération</span><h1 class="h2 mb-1">Gestion des jeux</h1><p class="text-secondary mb-0">{{ total }} jeu{{ total > 1 ? 'x' : '' }} trouvé{{ total > 1 ? 's' : '' }}.</p></div></div>
    <form class="gw-panel p-3 mb-4" method="get"><div class="row g-2"><div class="col-md-7"><label class="visually-hidden" for="recherche-jeu-admin">Rechercher</label><input id="recherche-jeu-admin" class="form-control" type="search" name="recherche" value="{{ recherche }}" placeholder="Nom, slug ou auteur"></div><div class="col-md-3"><label class="visually-hidden" for="statut-jeu-admin">Statut</label><select id="statut-jeu-admin" class="form-select" name="statut"><option value="">Tous les statuts</option>{% for statut in statuts %}<option value="{{ statut.value }}" {{ statutSelectionne == statut ? 'selected' }}>{{ statut.label }}</option>{% endfor %}</select></div><div class="col-md-2 d-grid"><button class="btn btn-primary"><i class="bi bi-search me-1"></i>Filtrer</button></div></div></form>
    <div class="gw-panel p-3"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Jeu</th><th>Créateur</th><th>Statut</th><th>Modification</th><th class="text-end">Actions</th></tr></thead><tbody>
    {% for jeu in jeux %}<tr><td><strong>{{ jeu.nom }}</strong><small class="d-block text-secondary">{{ jeu.slug }}</small></td><td>{{ jeu.pseudoAuteurFiche ?? 'Compte supprimé' }}</td><td><span class="badge text-bg-{{ jeu.statut.value == 'approuve' ? 'success' : (jeu.statut.value == 'en_attente' ? 'warning' : (jeu.statut.value == 'refuse' ? 'danger' : 'secondary')) }}">{{ jeu.statut.label }}</span></td><td>{{ jeu.modifieLe|date('d/m/Y H:i') }}</td><td><div class="d-flex flex-wrap justify-content-end gap-1"><a class="btn btn-sm btn-outline-primary" href="{{ path('app_moderation_jeu_voir', {id: jeu.id}) }}" aria-label="Examiner {{ jeu.nom }}"><i class="bi bi-eye-fill"></i></a>{% if jeu.statut.value == 'en_attente' %}<form method="post" action="{{ path('app_moderation_jeu_decider', {id: jeu.id, decision: 'refuser'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('moderation-jeu-' ~ jeu.id) }}"><button class="btn btn-sm btn-outline-danger">Refuser</button></form><form method="post" action="{{ path('app_moderation_jeu_decider', {id: jeu.id, decision: 'approuver'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('moderation-jeu-' ~ jeu.id) }}"><button class="btn btn-sm btn-success">Approuver</button></form>{% endif %}{% if is_granted('ROLE_ADMIN') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('app_jeu_proposition_modifier', {id: jeu.id}) }}" aria-label="Modifier {{ jeu.nom }}"><i class="bi bi-pencil-fill"></i></a><form method="post" action="{{ path('app_moderation_jeu_statut', {id: jeu.id}) }}" class="d-flex"><input type="hidden" name="_token" value="{{ csrf_token('statut-jeu-' ~ jeu.id) }}"><select class="form-select form-select-sm" name="statut" onchange="this.form.submit()" aria-label="Changer le statut de {{ jeu.nom }}">{% for statut in statuts %}<option value="{{ statut.value }}" {{ jeu.statut == statut ? 'selected' }}>{{ statut.label }}</option>{% endfor %}</select></form><form method="post" action="{{ path('app_moderation_jeu_supprimer', {id: jeu.id}) }}" onsubmit="return confirm('Supprimer définitivement ce jeu et ses contenus associés ?')"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-jeu-' ~ jeu.id) }}"><button class="btn btn-sm btn-outline-danger" aria-label="Supprimer {{ jeu.nom }}"><i class="bi bi-trash-fill"></i></button></form>{% endif %}</div></td></tr>{% else %}<tr><td colspan="5" class="text-center text-secondary py-5">Aucun jeu ne correspond aux filtres.</td></tr>{% endfor %}
    </tbody></table></div></div>
    {% if pages > 1 %}<nav class="mt-4" aria-label="Pagination"><ul class="pagination justify-content-center"><li class="page-item{{ page == 1 ? ' disabled' : '' }}"><a class="page-link" href="{{ path('app_moderation_jeux', {recherche: recherche, statut: statutSelectionne ? statutSelectionne.value : '', page: page - 1}) }}">Précédent</a></li><li class="page-item disabled"><span class="page-link">{{ page }} / {{ pages }}</span></li><li class="page-item{{ page == pages ? ' disabled' : '' }}"><a class="page-link" href="{{ path('app_moderation_jeux', {recherche: recherche, statut: statutSelectionne ? statutSelectionne.value : '', page: page + 1}) }}">Suivant</a></li></ul></nav>{% endif %}
</section></div>
{% endblock %}
