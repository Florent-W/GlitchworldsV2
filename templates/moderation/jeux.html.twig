{% extends 'base.html.twig' %}

{% block title %}Modération des jeux - GlitchWorlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}

{% block body %}
<section class="gw-panel p-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <i class="bi bi-shield-check text-primary fs-1" aria-hidden="true"></i>
        <div><h1 class="h2 mb-1">Modération des jeux</h1><p class="text-secondary mb-0">{{ jeux|length }} proposition{{ jeux|length > 1 ? 's' : '' }} en attente.</p></div>
    </div>

    {% if jeux is empty %}
        <div class="alert alert-success mb-0"><i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>Aucune proposition à modérer.</div>
    {% else %}
        <div class="vstack gap-3">
            {% for jeu in jeux %}
                <article class="border rounded-4 p-3">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                        <div>
                            <h2 class="h5 mb-1">{{ jeu.nom }}</h2>
                            <p class="text-secondary mb-2">{{ jeu.description }}</p>
                            <span class="small">Par {{ jeu.createur ? jeu.createur.pseudo : 'Membre supprimé' }}{% if jeu.categorie %} · {{ jeu.categorie.nom }}{% endif %}</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-outline-primary" href="{{ path('app_moderation_jeu_voir', { id: jeu.id }) }}">
                                <i class="bi bi-eye-fill me-1" aria-hidden="true"></i>Examiner
                            </a>
                            <form method="post" action="{{ path('app_moderation_jeu_decider', { id: jeu.id, decision: 'refuser' }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('moderation-jeu-' ~ jeu.id) }}">
                                <button class="btn btn-outline-danger" type="submit">Refuser</button>
                            </form>
                            <form method="post" action="{{ path('app_moderation_jeu_decider', { id: jeu.id, decision: 'approuver' }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('moderation-jeu-' ~ jeu.id) }}">
                                <button class="btn btn-success" type="submit">Approuver</button>
                            </form>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
