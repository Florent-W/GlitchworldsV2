{% extends 'base.html.twig' %}
{% block title %}Notifications - Glitchworlds{% endblock %}
{% block body %}<main class="container-fluid py-4"><header class="gw-page-heading mb-4"><div><span class="gw-eyebrow"><i class="bi bi-bell-fill"></i> Centre d’activité</span><h1 class="display-5 fw-bold mb-1">Notifications</h1><p class="text-secondary mb-0">Messages, succès et événements importants au même endroit.</p></div>{% if nonLues %}<form method="post" action="{{ path('app_notifications_tout_lire') }}"><input type="hidden" name="_token" value="{{ csrf_token('notifications-tout-lire') }}"><button class="btn btn-outline-primary"><i class="bi bi-check2-all"></i> Tout marquer comme lu</button></form>{% endif %}</header><section class="gw-panel overflow-hidden">{% for notification in notifications %}<article class="gw-notification {{ not notification.lue ? 'gw-notification--unread' }}"><span class="gw-notification__icon"><i class="bi bi-{{ notification.icone }}"></i></span><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><h2 class="h6 mb-1">{{ notification.titre }}</h2><time class="small text-secondary" data-controller="date-locale" data-date-locale-date-value="{{ notification.creeeLe|date('c') }}">{{ notification.creeeLe|date('d/m/Y H:i') }}</time></div><p class="mb-0 text-secondary">{{ notification.message }}</p></div>{% if not notification.lue or notification.url %}<form method="post" action="{{ path('app_notification_lire', {id: notification.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('lire-notification-' ~ notification.id) }}"><button class="btn btn-sm btn-{{ notification.lue ? 'outline-' : '' }}primary">{{ notification.url ? 'Voir' : 'Lu' }}</button></form>{% endif %}</article>{% else %}<div class="p-5 text-center"><i class="bi bi-bell-slash display-4 text-secondary"></i><h2 class="h4 mt-3">Aucune notification</h2><p class="text-secondary">Les nouveautés importantes apparaîtront ici.</p></div>{% endfor %}</section></main>{% endblock %}
