{% set estOptimisee = '.opt.webp' in fichier %}
<picture class="gw-responsive-picture">
    {% if estOptimisee and supporte_avif() %}
        <source
            type="image/avif"
            srcset="{{ asset(dossier ~ '/' ~ fichier|replace({'.webp': '-480.avif'})) }} 480w, {{ asset(dossier ~ '/' ~ fichier|replace({'.webp': '-960.avif'})) }} 960w, {{ asset(dossier ~ '/' ~ fichier|replace({'.webp': '-1440.avif'})) }} 1440w"
            sizes="{{ sizes|default('100vw') }}"
        >
    {% endif %}
    {% if estOptimisee %}
        <source
            type="image/webp"
            srcset="{{ asset(dossier ~ '/' ~ fichier|replace({'.webp': '-480.webp'})) }} 480w, {{ asset(dossier ~ '/' ~ fichier|replace({'.webp': '-960.webp'})) }} 960w, {{ asset(dossier ~ '/' ~ fichier|replace({'.webp': '-1440.webp'})) }} 1440w"
            sizes="{{ sizes|default('100vw') }}"
        >
    {% endif %}
    <img
        class="{{ classes|default('') }}"
        src="{{ asset(dossier ~ '/' ~ fichier) }}"
        alt="{{ alt|default('') }}"
        loading="{{ loading|default('lazy') }}"
        decoding="{{ decoding|default('async') }}"
        {% if style|default('') %}style="{{ style }}"{% endif %}
        {% if fetchpriority|default(false) %}fetchpriority="high"{% endif %}
    >
</picture>
