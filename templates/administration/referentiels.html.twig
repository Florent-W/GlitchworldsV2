{% extends 'base.html.twig' %}
{% block title %}{{ titre }} - Administration{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body %}<div class="gw-admin"><aside>{% include 'administration/_navigation.html.twig' %}</aside><section class="min-w-0"><span class="gw-eyebrow"><i class="bi bi-tags"></i> Référentiels</span><h1 class="display-6 fw-bold">{{ titre }}</h1><div class="nav nav-pills gap-2 mb-4">{% for cle, configuration in types %}<a class="nav-link{{ cle == type ? ' active' : '' }}" href="{{ path('app_administration_referentiels_liste', {type: cle}) }}">{{ configuration[1] }}</a>{% endfor %}</div><article class="gw-panel p-4 mb-4"><h2 class="h5">Ajouter un élément</h2><form class="row g-2" method="post" action="{{ path('app_administration_referentiels_enregistrer', {type: type}) }}"><input type="hidden" name="_token" value="{{ csrf_token('referentiel-' ~ type) }}"><div class="col-md"><label class="visually-hidden" for="nouveau-nom">Nom</label><input class="form-control" id="nouveau-nom" name="nom" maxlength="80" required placeholder="Nom"></div><div class="col-md-auto"><button class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Ajouter</button></div></form></article><article class="gw-panel p-4"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nom</th><th>Slug</th><th class="text-end">Actions</th></tr></thead><tbody>{% for element in elements %}<tr><td><form class="d-flex gap-2" method="post" action="{{ path('app_administration_referentiels_enregistrer', {type: type}) }}"><input type="hidden" name="_token" value="{{ csrf_token('referentiel-' ~ type) }}"><input type="hidden" name="id" value="{{ element.id }}"><input class="form-control form-control-sm" name="nom" value="{{ element.nom }}" maxlength="80" required><button class="btn btn-sm btn-outline-primary" aria-label="Enregistrer"><i class="bi bi-check-lg"></i></button></form></td><td><code>{{ element.slug }}</code></td><td class="text-end"><form method="post" action="{{ path('app_administration_referentiels_supprimer', {type: type, id: element.id}) }}" onsubmit="return confirm('Supprimer cet élément ?')"><input type="hidden" name="_token" value="{{ csrf_token('supprimer-referentiel-' ~ type ~ '-' ~ element.id) }}"><button class="btn btn-sm btn-outline-danger" aria-label="Supprimer"><i class="bi bi-trash"></i></button></form></td></tr>{% else %}<tr><td colspan="3" class="text-secondary">Aucun élément.</td></tr>{% endfor %}</tbody></table></div></article></section></div>{% endblock %}
