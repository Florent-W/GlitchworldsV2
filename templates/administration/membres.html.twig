{% extends 'base.html.twig' %}
{% block title %}Membres - Administration - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body %}<div class="gw-admin"><aside>{% include 'administration/_navigation.html.twig' %}</aside><section class="min-w-0"><div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4"><div><span class="gw-eyebrow">Administration</span><h1 class="display-6 fw-bold mb-0">Membres</h1></div><form class="d-flex gap-2" method="get"><input class="form-control" type="search" name="recherche" value="{{ recherche }}" placeholder="Pseudo ou e-mail"><button class="btn btn-primary"><i class="bi bi-search"></i><span class="visually-hidden">Rechercher</span></button></form></div><div class="gw-panel p-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Membre</th><th>E-mail</th><th>Rôle</th><th>Inscription</th><th></th></tr></thead><tbody>{% for membre in membres %}<tr><td><strong>{{ membre.pseudo }}</strong><small class="d-block text-secondary">#{{ membre.id }}</small></td><td>{{ membre.email ?? membre.emailLegacy ?? 'Non renseigné' }}</td><td>{% if 'ROLE_ADMIN' in membre.roles %}<span class="badge text-bg-danger">Administrateur</span>{% elseif 'ROLE_MODERATEUR' in membre.roles %}<span class="badge text-bg-warning">Modérateur</span>{% else %}<span class="badge text-bg-secondary">Membre</span>{% endif %}</td><td>{{ membre.inscritLe|date('d/m/Y') }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('app_profil', {id: membre.id}) }}">Voir</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-secondary py-4">Aucun membre trouvé.</td></tr>{% endfor %}</tbody></table></div></div></section></div>{% endblock %}
