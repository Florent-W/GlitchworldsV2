{% extends 'base.html.twig' %}
{% block title %}Tableau de bord - Administration - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}

{% block body %}
<div class="gw-admin">
    <aside>{% include 'administration/_navigation.html.twig' %}</aside>
    <section class="min-w-0">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div><span class="gw-eyebrow"><i class="bi bi-shield-check"></i> Back-office</span><h1 class="display-6 fw-bold mb-0">Tableau de bord</h1></div>
            <div class="d-flex gap-2"><div class="dropdown"><button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-download me-1"></i>Exporter</button><ul class="dropdown-menu">{% for type, libelle in {vues: 'Vues', jeux: 'Jeux', actualites: 'Actualités', membres: 'Membres', moderation: 'Modération'} %}<li><a class="dropdown-item" href="{{ path('app_administration_export', {type: type}) }}">{{ libelle }} (.csv)</a></li>{% endfor %}</ul></div><a class="btn btn-outline-primary" href="{{ path('app_administration_actualites_creer') }}"><i class="bi bi-file-earmark-plus me-2"></i>Ajouter une actualité</a><a class="btn btn-primary" href="{{ path('app_jeu_proposer') }}"><i class="bi bi-plus-lg me-2"></i>Ajouter un jeu</a></div>
        </div>

        <div class="row g-3 mb-4">
            {% set cartes = [
                {label: 'Jeux', valeur: statistiques.jeux, icon: 'controller', couleur: 'primary', url: path('app_jeux')},
                {label: 'Membres', valeur: statistiques.membres, icon: 'people-fill', couleur: 'success', url: path('app_administration_membres')},
                {label: 'Commentaires', valeur: statistiques.commentaires, icon: 'chat-dots-fill', couleur: 'info', url: path('app_moderation_commentaires')},
                {label: 'Signalements', valeur: statistiques.signalements, icon: 'flag-fill', couleur: 'warning', url: path('app_moderation_signalements')}
            ] %}
            {% for carte in cartes %}<div class="col-sm-6 col-xl-3"><a class="gw-admin-stat gw-panel" href="{{ carte.url }}"><span class="gw-admin-stat__icon text-bg-{{ carte.couleur }}"><i class="bi bi-{{ carte.icon }}"></i></span><div><strong>{{ carte.valeur|number_format(0, ',', ' ') }}</strong><span>{{ carte.label }}</span></div><i class="bi bi-chevron-right ms-auto text-secondary" aria-hidden="true"></i></a></div>{% endfor %}
        </div>

        {% if jeuxEnAttente > 0 %}<div class="alert alert-warning d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3"><span><i class="bi bi-exclamation-triangle-fill me-2"></i><strong>{{ jeuxEnAttente }}</strong> proposition{{ jeuxEnAttente > 1 ? 's' : '' }} de jeu à examiner.</span><a class="btn btn-sm btn-warning" href="{{ path('app_moderation_jeux') }}">Ouvrir la file</a></div>{% endif %}

        <article id="audience" class="gw-panel p-4 mb-4 gw-admin-anchor">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
                <div><h2 class="h4 mb-1">Audience réelle</h2><p class="text-secondary mb-0">{{ audience.vues|number_format(0, ',', ' ') }} vues par {{ audience.visiteurs|number_format(0, ',', ' ') }} visiteurs uniques sur la période.</p></div>
                <form method="get" action="{{ path('app_administration_tableau_de_bord') }}#audience"><input type="hidden" name="contenu" value="{{ searchConsole.contenu }}"><label class="visually-hidden" for="periode-statistiques">Période des statistiques</label><select id="periode-statistiques" class="form-select" name="periode" onchange="this.form.submit()">{% for periode in [7, 28, 30, 90, 180, 365] %}<option value="{{ periode }}"{{ audience.jours == periode ? ' selected' : '' }}>{{ periode == 90 ? '3 mois' : (periode == 180 ? '6 mois' : (periode == 365 ? '1 an' : periode ~ ' jours')) }}</option>{% endfor %}</select></form>
            </div>
            <div class="gw-admin-seo-metrics mb-4" aria-label="Indicateurs de visibilité des contenus">
                <div class="gw-admin-seo-metric">
                    <span class="gw-admin-seo-metric__icon text-bg-primary"><i class="bi bi-graph-up-arrow"></i></span>
                    <span><strong class="{{ audience.evolutionVues >= 0 ? 'text-success' : 'text-danger' }}">{{ audience.evolutionVues >= 0 ? '+' : '' }}{{ audience.evolutionVues }} %</strong><small>vues par rapport à la période précédente</small></span>
                </div>
                <div class="gw-admin-seo-metric">
                    <span class="gw-admin-seo-metric__icon text-bg-info"><i class="bi bi-files"></i></span>
                    <span><strong>{{ audience.pagesParVisiteur|number_format(2, ',', ' ') }}</strong><small>pages vues par visiteur</small></span>
                </div>
                <div class="gw-admin-seo-metric">
                    <span class="gw-admin-seo-metric__icon text-bg-success"><i class="bi bi-eye-fill"></i></span>
                    <span><strong>{{ audience.contenusVus|number_format(0, ',', ' ') }}</strong><small>contenus consultés sur la période</small></span>
                </div>
                <div class="gw-admin-seo-metric">
                    <span class="gw-admin-seo-metric__icon {{ audience.contenusSansVue > 0 ? 'text-bg-warning' : 'text-bg-success' }}"><i class="bi bi-{{ audience.contenusSansVue > 0 ? 'eye-slash-fill' : 'check-lg' }}"></i></span>
                    <span><strong>{{ audience.contenusSansVue|number_format(0, ',', ' ') }}</strong><small>contenus publiés sans vue sur la période</small></span>
                </div>
            </div>
            <div data-controller="graphique-vue" data-graphique-vue-labels-value="Vues|Visiteurs">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div class="d-flex gap-3 small"><span><i class="bi bi-circle-fill text-primary me-1"></i>Vues</span><span><i class="bi bi-circle-fill text-info me-1"></i>Visiteurs</span></div>
                    <div class="btn-group gw-chart-view-switch" role="group" aria-label="Présentation du graphique d’audience"><button type="button" class="btn btn-outline-secondary" data-graphique-vue-target="bouton" data-vue="barres" data-action="graphique-vue#changer"><i class="bi bi-bar-chart-fill me-1"></i>Barres</button><button type="button" class="btn btn-outline-secondary" data-graphique-vue-target="bouton" data-vue="courbe" data-action="graphique-vue#changer"><i class="bi bi-graph-up me-1"></i>Courbe</button></div>
                </div>
                <div class="overflow-x-auto" data-graphique-vue-target="barres"><div class="gw-admin-chart" style="grid-template-columns: repeat({{ audience.graphique|length }}, minmax(24px, 1fr)); min-width: {{ max(680, audience.graphique|length * 28) }}px" role="img" aria-label="Vues et visiteurs des {{ audience.jours }} derniers jours">{% for point in audience.graphique %}<div class="gw-admin-chart__day"><div class="gw-admin-chart__bars"><span class="gw-admin-chart__bar bg-primary" style="--gw-chart-height: {{ (point.vues / audience.maximum * 100)|round }}%" tabindex="0" data-graph-value="{{ point.vues }}" data-tooltip="{{ point.vues|number_format(0, ',', ' ') }} vue{{ point.vues > 1 ? 's' : '' }} · {{ point.jour }}" aria-label="{{ point.vues }} vue{{ point.vues > 1 ? 's' : '' }}, {{ point.jour }}"></span><span class="gw-admin-chart__bar bg-info" style="--gw-chart-height: {{ (point.visiteurs / audience.maximum * 100)|round }}%" tabindex="0" data-graph-value="{{ point.visiteurs }}" data-tooltip="{{ point.visiteurs|number_format(0, ',', ' ') }} visiteur{{ point.visiteurs > 1 ? 's' : '' }} · {{ point.jour }}" aria-label="{{ point.visiteurs }} visiteur{{ point.visiteurs > 1 ? 's' : '' }}, {{ point.jour }}"></span></div><small>{{ point.jour }}</small></div>{% endfor %}</div></div>
                <div class="gw-chart-line" data-graphique-vue-target="courbe" hidden><canvas role="img" aria-label="Courbes des vues et visiteurs des {{ audience.jours }} derniers jours"></canvas></div>
            </div>
            <div class="row g-4 mt-2">
                {% set classements = [
                    {titre: 'Jeux les plus vus', contenus: audience.jeux, route: 'app_jeu_show'},
                    {titre: 'Actualités les plus vues', contenus: audience.actualites, route: 'app_actualite_voir'}
                ] %}
                {% for classement in classements %}<div class="col-xl-6"><h3 class="h5">{{ classement.titre }}</h3><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Contenu</th><th>Vues</th><th>Visiteurs</th></tr></thead><tbody>{% for contenu in classement.contenus %}<tr><td><a class="gw-admin-table-link" href="{{ path(classement.route, {slug: contenu.slug, id: contenu.id}) }}">{{ contenu.titre }}<i class="bi bi-chevron-right" aria-hidden="true"></i></a></td><td>{{ contenu.vues }}</td><td>{{ contenu.visiteurs }}</td></tr>{% else %}<tr><td colspan="3" class="text-secondary">Aucune vue enregistrée.</td></tr>{% endfor %}</tbody></table></div></div>{% endfor %}
            </div>
        </article>

        <article id="performances-google" class="gw-panel p-4 mb-4 gw-admin-anchor">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
                <div>
                    <span class="gw-eyebrow"><i class="bi bi-google"></i> Référencement</span>
                    <h2 class="h4 mb-1">Performances Google</h2>
                    {% if searchConsole.performance %}
                        <p class="text-secondary mb-0">Données Search Console du {{ searchConsole.performance.debut|date('d/m/Y') }} au {{ searchConsole.performance.fin|date('d/m/Y') }}.</p>
                    {% else %}
                        <p class="text-secondary mb-0">Impressions, clics, CTR et position dans les résultats Google.</p>
                    {% endif %}
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    {% if searchConsole.performance %}
                        <form class="d-flex flex-nowrap gap-2" method="get" action="{{ path('app_administration_tableau_de_bord') }}#performances-google">
                            <label class="visually-hidden" for="periode-search-console">Période Search Console</label>
                            <select id="periode-search-console" class="form-select form-select-sm w-auto" name="periode" onchange="this.form.submit()">
                                {% for periode in [7, 28, 30, 90, 180, 365] %}<option value="{{ periode }}"{{ searchConsole.jours == periode ? ' selected' : '' }}>{{ periode == 90 ? '3 mois' : (periode == 180 ? '6 mois' : (periode == 365 ? '1 an' : periode ~ ' jours')) }}</option>{% endfor %}
                            </select>
                            <label class="visually-hidden" for="contenu-search-console">Type de contenu</label>
                            <select id="contenu-search-console" class="form-select form-select-sm w-auto" name="contenu" onchange="this.form.submit()">
                                <option value="tout"{{ searchConsole.contenu == 'tout' ? ' selected' : '' }}>Tout le site</option>
                                <option value="jeux"{{ searchConsole.contenu == 'jeux' ? ' selected' : '' }}>Jeux</option>
                                <option value="actualites"{{ searchConsole.contenu == 'actualites' ? ' selected' : '' }}>Actualités</option>
                            </select>
                        </form>
                    {% endif %}
                {% if searchConsole.connectee %}
                        <a class="btn btn-sm btn-outline-primary gw-search-console-action" href="https://search.google.com/search-console/performance/search-analytics" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Ouvrir Search Console</a>
                        <form method="post" action="{{ path('app_administration_search_console_deconnecter') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('deconnecter-search-console') }}">
                            <button class="btn btn-sm btn-outline-secondary gw-search-console-action">Déconnecter</button>
                        </form>
                {% elseif searchConsole.configuree %}
                    <a class="btn btn-primary" href="{{ path('app_administration_search_console_connecter') }}"><i class="bi bi-google me-2"></i>Connecter Search Console</a>
                {% endif %}
                </div>
            </div>

            {% if searchConsole.performance %}
                {% set google = searchConsole.performance %}
                {% for alerte in google.alertes|default([]) %}
                    <div class="alert alert-{{ alerte.niveau }} py-2 mb-3"><i class="bi bi-graph-down-arrow me-2" aria-hidden="true"></i>{{ alerte.texte }}</div>
                {% endfor %}
                <div class="gw-search-console-kpis mb-4">
                    <div><span>Clics</span><strong>{{ google.clics|number_format(0, ',', ' ') }}</strong><small class="{{ google.evolutionClics >= 0 ? 'text-success' : 'text-danger' }}">{{ google.evolutionClics >= 0 ? '+' : '' }}{{ google.evolutionClics }} % sur la période</small></div>
                    {% set evolutionImpressions = google.evolutionImpressions|default(0) %}
                    {% set variationCtr = google.variationCtr|default(0) %}
                    {% set gainPosition = google.gainPosition|default(0) %}
                    <div><span>Impressions</span><strong>{{ google.impressions|number_format(0, ',', ' ') }}</strong><small class="{{ evolutionImpressions >= 0 ? 'text-success' : 'text-danger' }}">{{ evolutionImpressions >= 0 ? '+' : '' }}{{ evolutionImpressions }} % sur la période</small></div>
                    <div><span>CTR moyen</span><strong>{{ google.ctr|number_format(1, ',', ' ') }} %</strong><small class="{{ variationCtr >= 0 ? 'text-success' : 'text-danger' }}">{{ variationCtr >= 0 ? '+' : '' }}{{ variationCtr|number_format(1, ',', ' ') }} point{{ variationCtr|abs >= 2 ? 's' : '' }}</small></div>
                    <div><span>Position moyenne</span><strong>{{ google.position|number_format(1, ',', ' ') }}</strong><small class="{{ gainPosition >= 0 ? 'text-success' : 'text-danger' }}">{{ gainPosition >= 0 ? '+' : '' }}{{ gainPosition|number_format(1, ',', ' ') }} place{{ gainPosition|abs >= 2 ? 's' : '' }}</small></div>
                </div>
                {% if google.graphique|default([]) is not empty %}
                    <div class="mb-4" data-controller="graphique-vue" data-graphique-vue-labels-value="Clics|Impressions">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div class="d-flex gap-3 small" aria-hidden="true"><span><i class="bi bi-circle-fill text-primary me-1"></i>Clics</span><span><i class="bi bi-circle-fill gw-text-purple me-1"></i>Impressions</span></div>
                            <div class="btn-group gw-chart-view-switch" role="group" aria-label="Présentation du graphique Search Console"><button type="button" class="btn btn-outline-secondary" data-graphique-vue-target="bouton" data-vue="barres" data-action="graphique-vue#changer"><i class="bi bi-bar-chart-fill me-1"></i>Barres</button><button type="button" class="btn btn-outline-secondary" data-graphique-vue-target="bouton" data-vue="courbe" data-action="graphique-vue#changer"><i class="bi bi-graph-up me-1"></i>Courbe</button></div>
                        </div>
                        <div class="overflow-x-auto" data-graphique-vue-target="barres"><div class="gw-admin-chart gw-search-console-chart" style="grid-template-columns: repeat({{ google.graphique|length }}, minmax(24px, 1fr)); min-width: {{ max(680, google.graphique|length * 28) }}px" role="img" aria-label="Clics et impressions dans Google sur {{ searchConsole.jours }} jours">
                            {% for point in google.graphique %}
                                <div class="gw-admin-chart__day">
                                    <div class="gw-admin-chart__bars">
                                        <span class="gw-admin-chart__bar bg-primary" style="--gw-chart-height: {{ (point.clics / google.maximumClics * 100)|round }}%" tabindex="0" data-graph-value="{{ point.clics }}" data-tooltip="{{ point.clics }} clic{{ point.clics > 1 ? 's' : '' }} · {{ point.date|date('d/m/Y') }}" aria-label="{{ point.clics }} clic{{ point.clics > 1 ? 's' : '' }}, {{ point.date|date('d/m/Y') }}"></span>
                                        <span class="gw-admin-chart__bar gw-bg-purple" style="--gw-chart-height: {{ (point.impressions / google.maximumImpressions * 100)|round }}%" tabindex="0" data-graph-value="{{ point.impressions }}" data-tooltip="{{ point.impressions }} impression{{ point.impressions > 1 ? 's' : '' }} · {{ point.date|date('d/m/Y') }}" aria-label="{{ point.impressions }} impression{{ point.impressions > 1 ? 's' : '' }}, {{ point.date|date('d/m/Y') }}"></span>
                                    </div>
                                    <small>{{ point.jour }}</small>
                                </div>
                            {% endfor %}
                        </div></div>
                        <div class="gw-chart-line" data-graphique-vue-target="courbe" hidden><canvas role="img" aria-label="Courbes des clics et impressions Google sur {{ searchConsole.jours }} jours"></canvas></div>
                    </div>
                {% endif %}
                <div class="row g-4">
                    {% for titre, lignes in {'Requêtes principales': google.requetes, 'Pages principales': google.pages} %}
                        {% set estRequete = loop.first %}
                        <div class="col-xl-6">
                            <h3 class="h6 mb-3">{{ titre }}</h3>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 gw-search-console-table">
                                    <thead><tr><th>{{ estRequete ? 'Requête' : 'Page' }}</th><th>Clics</th><th>Impr.</th><th>CTR</th><th>Pos.</th></tr></thead>
                                    <tbody>{% for ligne in lignes %}<tr><td title="{{ ligne.keys[0] }}"><a href="{{ estRequete ? 'https://www.google.com/search?q=' ~ (ligne.keys[0]|url_encode) : ligne.keys[0] }}" target="_blank" rel="noopener noreferrer"><span>{{ ligne.keys[0] }}</span><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></td><td>{{ ligne.clicks|round }}</td><td>{{ ligne.impressions|round }}</td><td>{{ (ligne.ctr * 100)|number_format(1, ',', ' ') }} %</td><td>{{ ligne.position|number_format(1, ',', ' ') }}</td></tr>{% else %}<tr><td colspan="5" class="text-secondary">Aucune donnée sur cette période.</td></tr>{% endfor %}</tbody>
                                </table>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {% if google.appareils|default([]) is not empty %}
                    <div class="mt-4">
                        <h3 class="h6 mb-3">Performances par appareil</h3>
                        <div class="gw-search-console-devices">
                            {% for appareil in google.appareils %}
                                <div class="gw-search-console-device">
                                    <i class="bi bi-{{ appareil.libelle == 'Mobile' ? 'phone' : (appareil.libelle == 'Tablette' ? 'tablet' : 'display') }}" aria-hidden="true"></i>
                                    <span><strong>{{ appareil.libelle }}</strong><small>{{ appareil.clicks|round }} clic{{ appareil.clicks|round > 1 ? 's' : '' }} · {{ appareil.impressions|round }} impressions</small></span>
                                    <em>{{ (appareil.ctr * 100)|number_format(1, ',', ' ') }} % CTR</em>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                {% if google.insights|default(null) %}
                    <section class="gw-search-insights mt-4" aria-labelledby="search-insights-title">
                        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                            <div><span class="gw-eyebrow">Analyse</span><h3 id="search-insights-title" class="h5 mb-0">Insights</h3></div>
                            <small class="text-secondary">Comparaison avec les {{ searchConsole.jours }} jours précédents</small>
                        </div>
                        <div class="gw-search-insights__grid">
                            {% for titre, lignes in {'Requêtes qui évoluent': google.insights.requetes, 'Pages qui évoluent': google.insights.pages} %}
                                {% set pagesInsights = loop.index == 2 %}
                                <div class="gw-search-insight-card">
                                    <h4>{{ titre }}</h4>
                                    <div class="gw-search-insight-list">
                                        {% for ligne in lignes %}
                                            <a href="{{ pagesInsights ? ligne.libelle : 'https://www.google.com/search?q=' ~ (ligne.libelle|url_encode) }}" target="_blank" rel="noopener noreferrer">
                                                <span title="{{ ligne.libelle }}">{{ ligne.libelle }}</span>
                                                <strong class="{{ ligne.variation > 0 ? 'text-success' : 'text-danger' }}">{{ ligne.variation > 0 ? '+' : '' }}{{ ligne.variation }} clic{{ ligne.variation|abs > 1 ? 's' : '' }}</strong>
                                            </a>
                                        {% else %}<p class="text-secondary small mb-0">Pas encore assez de variation.</p>{% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                            <div class="gw-search-insight-card">
                                <h4>Opportunités de clics</h4>
                                <div class="gw-search-insight-list">
                                    {% for ligne in google.insights.opportunites %}
                                        <a href="https://www.google.com/search?q={{ ligne.keys[0]|url_encode }}" target="_blank" rel="noopener noreferrer">
                                            <span title="{{ ligne.keys[0] }}">{{ ligne.keys[0] }}</span>
                                            <strong>{{ ligne.impressions|round }} impr. · {{ (ligne.ctr * 100)|number_format(1, ',', ' ') }} %</strong>
                                        </a>
                                    {% else %}<p class="text-secondary small mb-0">Aucune opportunité nette sur cette période.</p>{% endfor %}
                                </div>
                            </div>
                            <div class="gw-search-insight-card">
                                <h4>Proches du top 10</h4>
                                <div class="gw-search-insight-list">
                                    {% for ligne in google.insights.prochesTop10|default([]) %}
                                        <a href="https://www.google.com/search?q={{ ligne.keys[0]|url_encode }}" target="_blank" rel="noopener noreferrer">
                                            <span title="{{ ligne.keys[0] }}">{{ ligne.keys[0] }}</span>
                                            <strong>Pos. {{ ligne.position|number_format(1, ',', ' ') }} · {{ ligne.impressions|round }} impr.</strong>
                                        </a>
                                    {% else %}<p class="text-secondary small mb-0">Aucune requête entre les positions 8 et 20.</p>{% endfor %}
                                </div>
                            </div>
                            {% for titre, lignes in {'Pages en progression': google.insights.positions.gains|default([]), 'Pages en recul': google.insights.positions.pertes|default([])} %}
                                <div class="gw-search-insight-card">
                                    <h4>{{ titre }}</h4>
                                    <div class="gw-search-insight-list">
                                        {% for ligne in lignes %}
                                            <a href="{{ ligne.page }}" target="_blank" rel="noopener noreferrer">
                                                <span title="{{ ligne.page }}">{{ ligne.page }}</span>
                                                <strong class="{{ ligne.gain > 0 ? 'text-success' : 'text-danger' }}">{{ ligne.gain > 0 ? '+' : '' }}{{ ligne.gain|number_format(1, ',', ' ') }} · pos. {{ ligne.position|number_format(1, ',', ' ') }}</strong>
                                            </a>
                                        {% else %}<p class="text-secondary small mb-0">Pas de variation significative.</p>{% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        {% if google.pays|default([]) is not empty %}
                            <div class="gw-search-countries mt-3">
                                <strong>Principaux pays</strong>
                                {% for pays in google.pays %}<span><b>{{ pays.libelle }}</b> {{ pays.clicks|round }} clic{{ pays.clicks|round > 1 ? 's' : '' }}</span>{% endfor %}
                            </div>
                        {% endif %}
                    </section>
                {% endif %}
            {% elseif searchConsole.erreur %}
                <div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Les données Search Console sont momentanément indisponibles. Vous pouvez déconnecter puis reconnecter Google.</div>
            {% elseif not searchConsole.configuree %}
                <div class="alert alert-warning mb-0">Ajoutez <code>GOOGLE_SEARCH_CONSOLE_PROPERTY</code> dans le fichier <code>.env.local</code> de production pour activer la connexion.</div>
            {% else %}
                <div class="gw-search-console-empty"><i class="bi bi-bar-chart-line"></i><p class="mb-0">Connectez le compte Google qui possède la propriété <strong>glitchworlds.com</strong>.</p></div>
            {% endif %}
        </article>

        <article class="gw-panel p-4 mb-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-4"><div><h2 class="h4 mb-1">Statistiques</h2><p class="text-secondary mb-0">Activité réelle des 7 derniers jours</p></div><span class="badge rounded-pill text-bg-light align-self-sm-start">30 derniers jours</span></div>
            <div class="row g-4 align-items-stretch">
                <div class="col-xl-8">
                    <div class="d-flex gap-3 small mb-3"><span><i class="bi bi-circle-fill text-primary me-1"></i>Commentaires</span><span><i class="bi bi-circle-fill text-success me-1"></i>Nouveaux membres</span></div>
                    <div class="gw-admin-chart" role="img" aria-label="Graphique des commentaires et nouveaux membres des sept derniers jours">
                        {% for point in tendances.graphique %}
                            <div class="gw-admin-chart__day">
                                <div class="gw-admin-chart__bars">
                                    <span class="gw-admin-chart__bar bg-primary" style="--gw-chart-height: {{ (point.commentaires / tendances.maximum * 100)|round }}%" tabindex="0" data-tooltip="{{ point.commentaires|number_format(0, ',', ' ') }} commentaire{{ point.commentaires > 1 ? 's' : '' }} · {{ point.jour }}" aria-label="{{ point.commentaires }} commentaire{{ point.commentaires > 1 ? 's' : '' }}, {{ point.jour }}"></span>
                                    <span class="gw-admin-chart__bar bg-success" style="--gw-chart-height: {{ (point.membres / tendances.maximum * 100)|round }}%" tabindex="0" data-tooltip="{{ point.membres|number_format(0, ',', ' ') }} nouveau{{ point.membres > 1 ? 'x' : '' }} membre{{ point.membres > 1 ? 's' : '' }} · {{ point.jour }}" aria-label="{{ point.membres }} nouveau{{ point.membres > 1 ? 'x' : '' }} membre{{ point.membres > 1 ? 's' : '' }}, {{ point.jour }}"></span>
                                </div>
                                <small>{{ point.jour }}</small>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="col-xl-4"><div class="row g-3 h-100">
                    {% set resumes = [
                        {label: 'Nouveaux membres', valeur: tendances.membres30, evolution: tendances.evolutionMembres, icon: 'person-plus-fill', couleur: 'success'},
                        {label: 'Commentaires', valeur: tendances.commentaires30, evolution: tendances.evolutionCommentaires, icon: 'chat-dots-fill', couleur: 'primary'},
                        {label: 'Jeux ajoutés', valeur: tendances.jeux30, evolution: null, icon: 'controller', couleur: 'warning'}
                    ] %}
                    {% for resume in resumes %}<div class="col-sm-4 col-xl-12"><div class="gw-admin-summary"><i class="bi bi-{{ resume.icon }} text-{{ resume.couleur }}"></i><span><strong>{{ resume.valeur }}</strong><small>{{ resume.label }}</small></span>{% if resume.evolution is not null %}<em class="{{ resume.evolution >= 0 ? 'text-success' : 'text-danger' }}">{{ resume.evolution >= 0 ? '+' : '' }}{{ resume.evolution }}%</em>{% else %}<em class="text-secondary">Nouveau</em>{% endif %}</div></div>{% endfor %}
                </div></div>
            </div>
        </article>



        <div class="row g-4">
            <div class="col-xl-8"><article class="gw-panel p-4 h-100"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Activité récente</h2><a href="{{ path('app_moderation_commentaires') }}">Modérer</a></div><div class="gw-admin-activity">{% for activite in activites %}<a class="gw-admin-activity__item" href="{{ activite.url ?? '#' }}"><span class="gw-admin-activity__icon text-bg-{{ activite.couleur }}"><i class="bi bi-{{ activite.icone }}"></i></span><span class="flex-grow-1"><strong>{{ activite.auteur }}</strong> {{ activite.texte }}<time datetime="{{ activite.date|date('c') }}">{{ activite.date|date('d/m/Y à H:i') }}</time></span><i class="bi bi-chevron-right text-secondary"></i></a>{% else %}<p class="text-secondary mb-0">Aucune activité récente.</p>{% endfor %}</div></article></div>
            <div class="col-xl-4"><article class="gw-panel p-4 h-100"><h2 class="h4 mb-3">Accès rapide</h2><div class="d-grid gap-2"><a class="gw-admin-quick" href="{{ path('app_moderation_jeux') }}"><i class="bi bi-controller"></i><span><strong>Valider les jeux</strong><small>{{ jeuxEnAttente }} en attente</small></span></a><a class="gw-admin-quick" href="{{ path('app_administration_membres') }}"><i class="bi bi-people-fill"></i><span><strong>Voir les membres</strong><small>Comptes et rôles</small></span></a><a class="gw-admin-quick" href="{{ path('app_moderation_commentaires') }}"><i class="bi bi-chat-dots-fill"></i><span><strong>Commentaires</strong><small>Édition et suppression</small></span></a><a class="gw-admin-quick" href="{{ path('app_moderation_actualites') }}"><i class="bi bi-newspaper"></i><span><strong>Actualités</strong><small>Propositions et éditorial</small></span></a></div></article></div>
        </div>

        <article class="gw-panel p-4 mt-4"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Derniers jeux</h2><a href="{{ path('app_jeux') }}">Voir tous les jeux</a></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Jeu</th><th>Créateur</th><th>Statut</th><th>Date</th><th></th></tr></thead><tbody>{% for jeu in derniersJeux %}<tr><td class="fw-semibold"><a class="gw-admin-table-link" href="{{ jeu.statut.value == 'en_attente' ? path('app_moderation_jeu_voir', {id: jeu.id}) : path('app_jeu_show', {slug: jeu.slug, id: jeu.id}) }}">{{ jeu.nom }}</a></td><td>{% if jeu.createur %}<a class="gw-admin-table-link" href="{{ path('app_profil', {id: jeu.createur.id}) }}">{{ jeu.createur.pseudo }}</a>{% else %}Importé{% endif %}</td><td><span class="badge {{ jeu.statut.value == 'approuve' ? 'text-bg-success' : (jeu.statut.value == 'en_attente' ? 'text-bg-warning' : 'text-bg-secondary') }}">{{ jeu.statut.label }}</span></td><td>{{ jeu.creeLe|date('d/m/Y') }}</td><td class="text-end">{% if jeu.statut.value == 'en_attente' %}<a class="btn btn-sm btn-outline-primary" href="{{ path('app_moderation_jeu_voir', {id: jeu.id}) }}">Examiner</a>{% else %}<a class="btn btn-sm btn-outline-secondary" href="{{ path('app_jeu_show', {slug: jeu.slug, id: jeu.id}) }}" aria-label="Voir {{ jeu.nom }}"><i class="bi bi-eye"></i></a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></article>

        <article class="gw-panel p-4 mt-4"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Journal de modération</h2><a class="btn btn-sm btn-outline-secondary" href="{{ path('app_administration_export', {type: 'moderation'}) }}"><i class="bi bi-download me-1"></i>Exporter</a></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Modérateur</th><th>Action</th><th>Détail</th></tr></thead><tbody>{% for action in journalModeration %}<tr><td>{{ action.effectueeLe|date('d/m/Y H:i') }}</td><td>{% if action.moderateur %}<a class="gw-admin-table-link" href="{{ path('app_profil', {id: action.moderateur.id}) }}">{{ action.moderateur.pseudo }}</a>{% else %}Compte supprimé{% endif %}</td><td><span class="badge text-bg-secondary">{{ action.action }}</span></td><td>{{ action.resume }}</td></tr>{% else %}<tr><td colspan="4" class="text-secondary">Aucune action enregistrée pour le moment.</td></tr>{% endfor %}</tbody></table></div></article>
    </section>
</div>
{% endblock %}
