<nav class="gw-admin-nav gw-panel p-2" aria-label="Navigation de l’administration">
    {% set route = app.request.attributes.get('_route') %}
    {% set liens = [
        {route: 'app_administration_tableau_de_bord', prefixe: 'app_administration_tableau', icon: 'speedometer2', label: 'Tableau de bord'},
        {route: 'app_administration_membres', prefixe: 'app_administration_membres', icon: 'people-fill', label: 'Membres'},
        {route: 'app_administration_referentiels_liste', params: {type: 'categories'}, prefixe: 'app_administration_referentiels', icon: 'tags-fill', label: 'Référentiels'}
    ] %}
    {% for lien in liens %}
        <a class="gw-admin-nav__link{{ route starts with lien.prefixe ? ' is-active' : '' }}" href="{{ path(lien.route, lien.params ?? {}) }}">
            <i class="bi bi-{{ lien.icon }}" aria-hidden="true"></i><span>{{ lien.label }}</span>
        </a>
    {% endfor %}
    {% if is_granted('ROLE_MODERATEUR') %}
        <hr class="my-2">
        <a class="gw-admin-nav__link" href="{{ path('app_moderation_accueil') }}"><i class="bi bi-shield-check"></i><span>Modération</span></a>
    {% endif %}
    <hr class="my-2">
    <a class="gw-admin-nav__link" href="{{ path('app_home') }}"><i class="bi bi-arrow-left-circle"></i><span>Retour au site</span></a>
</nav>
