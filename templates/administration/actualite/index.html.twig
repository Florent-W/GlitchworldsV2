{% extends 'base.html.twig' %}

{% block title %}Administration des actualités - GlitchWorlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}

{% block body %}
<section class="gw-panel p-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div><h1 class="h2 mb-1">Administration des actualités</h1><p class="text-secondary mb-0">{{ actualites|length }} article{{ actualites|length > 1 ? 's' : '' }}.</p></div>
        <a class="btn btn-primary" href="{{ path('app_administration_actualites_creer') }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Créer une actualité</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Titre</th><th>Catégorie</th><th>Statut</th><th>Date</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            {% for actualite in actualites %}
                <tr>
                    <td><strong>{{ actualite.titre }}</strong></td>
                    <td>{{ actualite.categorie.label }}</td>
                    <td><span class="badge {{ actualite.statut.value == 'publiee' ? 'text-bg-success' : (actualite.statut.value == 'en_attente' ? 'text-bg-warning' : 'text-bg-secondary') }}">{{ actualite.statut.value == 'publiee' ? 'Publiée' : (actualite.statut.value == 'en_attente' ? 'En attente' : 'Brouillon') }}</span></td>
                    <td>{{ actualite.publieeLe|date('d/m/Y') }}</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('app_administration_actualites_modifier', { id: actualite.id }) }}"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Modifier</a></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-secondary py-4">Aucune actualité.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
