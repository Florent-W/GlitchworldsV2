{% extends 'base.html.twig' %}

{% block title %}{{ titre }} - Administration - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body_attributes %} data-turbo="false"{% endblock %}

{% block body %}
<div class="gw-admin">
    <aside>{% include 'moderation/_navigation.html.twig' %}</aside>
    <section class="min-w-0">
        <div class="gw-panel p-4 p-lg-5 mx-auto" style="max-width: 920px">
            <nav aria-label="Fil d’Ariane"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_moderation_actualites') }}">Actualités</a></li><li class="breadcrumb-item active" aria-current="page">{{ titre }}</li></ol></nav>
            <h1 class="h2 mb-4">{{ titre }}</h1>

            {{ form_start(formulaire) }}
                {{ form_row(formulaire.titre) }}
                {{ form_row(formulaire.description) }}
                {% include '_editeur_bbcode.html.twig' with { champ: formulaire.contenu, templates: 'actualite' } only %}
                {{ form_row(formulaire.banniereFichier) }}
                {% if formulaire.vars.data.banniere and not (formulaire.vars.data.banniere starts with 'legacy:') %}
                    <img class="img-fluid rounded-3 border mb-3" src="{{ asset('uploads/actualites/' ~ formulaire.vars.data.id ~ '/' ~ formulaire.vars.data.banniere) }}" alt="Bannière actuelle" loading="lazy">
                {% endif %}
                {{ form_row(formulaire.miniatureFichier) }}
                {% if formulaire.vars.data.miniature and not (formulaire.vars.data.miniature starts with 'legacy:') %}
                    <img class="img-fluid rounded-3 border mb-3" src="{{ asset('uploads/actualites/' ~ formulaire.vars.data.id ~ '/' ~ formulaire.vars.data.miniature) }}" alt="Miniature actuelle" loading="lazy">
                {% endif %}
                {{ form_row(formulaire.jeux) }}
                <div class="row"><div class="col-md-6">{{ form_row(formulaire.categorie) }}</div><div class="col-md-6">{{ form_row(formulaire.statut) }}</div></div>
                <div class="d-flex gap-2">{{ form_widget(formulaire.enregistrer) }}<a class="btn btn-outline-secondary" href="{{ path('app_moderation_actualites') }}">Annuler</a></div>
            {{ form_end(formulaire) }}
        </div>
    </section>
</div>
<script>
(function (form) {
    if (!form) return;
    const avertir = () => { window.onbeforeunload = (e) => { e.preventDefault(); e.returnValue = ''; }; };
    form.addEventListener('input', avertir);
    form.addEventListener('change', avertir);
    form.addEventListener('submit', () => { window.onbeforeunload = null; });
})(document.querySelector('form[name="actualite"]'));
</script>
{% endblock %}
