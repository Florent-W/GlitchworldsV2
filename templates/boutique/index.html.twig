{% extends 'base.html.twig' %}
{% block title %}Boutique - GlitchWorlds{% endblock %}
{% block meta_description %}Utilise tes points GlitchWorlds pour débloquer des badges et des titres de profil.{% endblock %}
{% block body %}
<section class="gw-shop">
    <header class="gw-page-heading mb-4"><div><span class="gw-eyebrow"><i class="bi bi-bag-fill"></i> Récompenses</span><h1 class="display-5 fw-bold mb-1">Boutique</h1><p class="text-secondary mb-0">Transforme les points gagnés dans la communauté en objets de collection.</p></div>{% if app.user %}<div class="gw-shop__balance"><i class="bi bi-star-fill"></i><span><strong>{{ app.user.points|number_format(0, ',', ' ') }}</strong> points disponibles</span></div>{% else %}<a class="btn btn-primary" href="{{ path('app_connexion') }}">Se connecter pour acheter</a>{% endif %}</header>
    <div class="row g-4">
        {% for article in articles %}<div class="col-md-6 col-xl-4"><article class="gw-shop-card gw-panel h-100"><div class="gw-shop-card__visual text-bg-{{ article.couleur }}"><i class="bi bi-{{ article.icone }}"></i></div><div class="p-4 d-flex flex-column h-100"><div class="d-flex justify-content-between gap-2 mb-2"><span class="badge text-bg-{{ article.couleur }}-subtle text-{{ article.couleur }}-emphasis">{{ article.type.label }}</span>{% if article.stock is not null %}<small class="text-secondary">{{ article.stock }} restant{{ article.stock > 1 ? 's' : '' }}</small>{% endif %}</div><h2 class="h4">{{ article.nom }}</h2><p class="text-secondary flex-grow-1">{{ article.description }}</p><div class="d-flex justify-content-between align-items-center gap-3"><strong class="fs-5 text-warning"><i class="bi bi-star-fill me-1"></i>{{ article.prix }} pts</strong>{% if article.id in articlesPossedes %}{% if article.type.value == 'titre' and app.user %}<form method="post" action="{{ path('app_boutique_equiper', {id: article.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('equiper-article-' ~ article.id) }}"><button class="btn {{ app.user.titreEquipe == article ? 'btn-success' : 'btn-outline-primary' }}" {{ app.user.titreEquipe == article ? 'disabled' }}>{{ app.user.titreEquipe == article ? 'Équipé' : 'Équiper' }}</button></form>{% else %}<span class="badge text-bg-success"><i class="bi bi-check-lg me-1"></i>Possédé</span>{% endif %}{% elseif app.user %}<form method="post" action="{{ path('app_boutique_acheter', {id: article.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('acheter-article-' ~ article.id) }}"><button class="btn btn-primary" {{ not article.disponible or app.user.points < article.prix ? 'disabled' }}>{{ article.disponible ? (app.user.points >= article.prix ? 'Acheter' : 'Points insuffisants') : 'Épuisé' }}</button></form>{% endif %}</div></div></article></div>{% endfor %}
    </div>
    {% if app.user and achats is not empty %}<section class="gw-panel p-4 mt-5"><h2 class="h4 mb-3"><i class="bi bi-collection-fill text-primary me-2"></i>Ma collection</h2><div class="d-flex flex-wrap gap-2">{% for achat in achats %}<span class="badge rounded-pill text-bg-{{ achat.article.couleur }}-subtle text-{{ achat.article.couleur }}-emphasis p-2"><i class="bi bi-{{ achat.article.icone }} me-1"></i>{{ achat.article.nom }}</span>{% endfor %}</div></section>{% endif %}
</section>
{% endblock %}
