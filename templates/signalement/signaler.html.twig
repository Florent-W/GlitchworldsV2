{% extends 'base.html.twig' %}
{% block title %}Signaler un contenu - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body %}
<section class="gw-panel p-4 p-md-5 mx-auto" style="max-width:760px">
    <div class="d-flex align-items-center gap-3 mb-4"><span class="gw-settings__icon text-danger"><i class="bi bi-flag-fill"></i></span><div><h1 class="h2 mb-1">Signaler un contenu</h1><p class="text-secondary mb-0">Le signalement sera uniquement visible par l’équipe de modération.</p></div></div>
    <div class="alert alert-light border"><strong>{{ signalement.typeCible }}</strong><p class="mb-0 mt-1">{{ signalement.extraitCible|slice(0, 240) }}</p></div>
    {{ form_start(formulaire) }}{{ form_row(formulaire.motif) }}{{ form_row(formulaire.details) }}<div class="d-flex justify-content-end gap-2"><button class="btn btn-outline-secondary" type="button" onclick="history.back()">Annuler</button>{{ form_widget(formulaire.envoyer) }}</div>{{ form_end(formulaire) }}
</section>
{% endblock %}
