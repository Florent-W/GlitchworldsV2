{% extends 'base.html.twig' %}
{% block title %}Nouveau message - Glitchworlds{% endblock %}
{% block robots_meta %}noindex,nofollow{% endblock %}
{% block body %}<section class="gw-panel p-4 p-md-5 mx-auto" style="max-width:760px"><nav aria-label="Fil d’Ariane"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_messages') }}">Messagerie</a></li><li class="breadcrumb-item active">Nouveau message</li></ol></nav><h1 class="h2 mb-4">Nouveau message</h1>{{ form_start(formulaire) }}{{ form_row(formulaire.destinataire) }}{{ form_row(formulaire.contenu) }}{{ form_row(formulaire.fichier) }}<div class="d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="bi bi-send-fill me-1"></i>Envoyer</button><a class="btn btn-outline-secondary" href="{{ path('app_messages') }}">Annuler</a></div>{{ form_end(formulaire) }}</section>{% endblock %}
